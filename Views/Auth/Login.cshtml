@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="fade-in">
    <div class="max-w-md mx-auto mt-8">
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <div class="px-6 py-4 bg-gradient-to-r from-primary-500 to-primary-600 text-center">
                <h1 class="text-xl font-bold text-white">TechRent</h1>
                <p class="text-primary-100 text-sm mt-1">Inicia sesión para continuar</p>
            </div>
            <div class="p-6">
                @if (!string.IsNullOrEmpty(ViewBag.Error))
                {
                    <div class="bg-rose-50 border border-rose-200 text-rose-600 text-sm rounded-xl px-4 py-3 mb-4">@ViewBag.Error</div>
                }
                <form method="post" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-slate-600 mb-1.5">Email</label>
                        <input type="email" name="email" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" required placeholder="admin@techrent.com" />
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-slate-600 mb-1.5">Contraseña</label>
                        <input type="password" name="password" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" required placeholder="Admin@123" />
                    </div>
                    <button type="submit" class="w-full px-5 py-2.5 rounded-xl bg-primary-500 text-white text-sm font-semibold hover:bg-primary-600 transition shadow-sm">
                        Ingresar
                    </button>
                </form>

                <div class="relative my-5">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-slate-200"></div>
                    </div>
                    <div class="relative flex justify-center">
                        <span class="bg-white px-3 text-xs text-slate-400">O continúa con</span>
                    </div>
                </div>

                <form asp-action="ExternalLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <input type="hidden" name="provider" value="Google" />
                    <button type="submit" class="w-full flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl border border-slate-200 text-sm font-medium text-slate-600 hover:border-slate-300 hover:bg-slate-50 transition">
                        <svg width="20" height="20" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path fill="#4285F4" d="M47.532 24.552c0-1.632-.142-3.2-.422-4.704H24.48v8.91h12.964c-.56 2.992-2.25 5.536-4.8 7.242v6.024h7.764c4.542-4.184 7.168-10.336 7.168-17.472z"/>
                            <path fill="#34A853" d="M24.48 48c6.48 0 11.908-2.144 15.876-5.784l-7.764-6.024c-2.144 1.424-4.88 2.264-8.112 2.264-6.24 0-11.536-4.208-13.424-9.872H3.102v6.216C7.078 42.656 15.222 48 24.48 48z"/>
                            <path fill="#FBBC05" d="M11.056 28.584c-.48-1.424-.752-2.944-.752-4.584s.272-3.16.752-4.584v-6.216H3.102C1.104 17.064 0 20.392 0 24s1.104 6.936 3.102 9.936l7.954-5.352z"/>
                            <path fill="#EA4335" d="M24.48 9.544c3.52 0 6.68 1.216 9.168 3.584l6.864-6.864C36.364 2.12 30.948 0 24.48 0 15.222 0 7.078 5.344 3.102 14.064l7.954 5.352c1.888-5.664 7.184-9.872 13.424-9.872z"/>
                        </svg>
                        Google
                    </button>
                </form>
            </div>
            <div class="px-6 py-3 bg-slate-50 border-t border-slate-100 text-center rounded-b-2xl">
                <span class="text-xs text-slate-500">¿No tienes cuenta? </span>
                <a asp-area="Identity" asp-page="/Account/Register" class="text-xs font-semibold text-primary-500 hover:text-primary-600 transition">Regístrate</a>
            </div>
        </div>
    </div>
</div>
