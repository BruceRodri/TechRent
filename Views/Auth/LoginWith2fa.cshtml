@{
    ViewData["Title"] = "Verificacion de autenticador de dos factores";
    var error = ViewData["Error"] as string;
}

<div class="min-h-[70vh] flex items-center justify-center fade-in">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <div class="px-8 pt-8 pb-6 text-center">
                <div class="w-14 h-14 rounded-2xl bg-primary-100 flex items-center justify-center mx-auto mb-4">
                    <i class="bi bi-shield-lock text-primary-500 text-xl"></i>
                </div>
                <h2 class="text-xl font-bold text-slate-800 mb-1">Verificacion 2FA</h2>
                <p class="text-sm text-slate-400">Ingresa el codigo de tu aplicacion de autenticacion</p>
            </div>

            <form asp-action="LoginWith2fa" asp-controller="Auth" method="post" class="px-8 pb-8">
                <div asp-validation-summary="ModelOnly" class="bg-rose-50 border border-rose-200 text-rose-600 text-sm rounded-xl px-4 py-3 mb-4" role="alert"></div>

                <div class="mb-6">
                    <label class="block text-sm font-medium text-slate-600 mb-1.5">Codigo de autenticacion</label>
                    <input name="authenticatorCode"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition text-center text-lg tracking-[0.3em] font-mono"
                           autocomplete="off" placeholder="000000" required />
                </div>

                <button type="submit"
                        class="w-full py-2.5 rounded-xl bg-primary-500 text-white text-sm font-semibold hover:bg-primary-600 transition shadow-sm">
                    Iniciar sesion
                </button>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="bg-rose-50 border border-rose-200 text-rose-600 text-sm rounded-xl px-4 py-3 mt-4 flex items-center gap-2">
                        <i class="bi bi-exclamation-triangle"></i> @error
                    </div>
                }
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
