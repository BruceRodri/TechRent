@{
    var totalPages = (int)ViewBag.TotalPages;
    var pageNumber = (int)ViewBag.PageNumber;
    var searchString = ViewBag.SearchString as string ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}

@if (totalPages > 1)
{
    <div class="flex flex-col items-center gap-2 mt-6">
        <nav class="flex items-center gap-1">
            <a asp-action="@action" asp-route-pageNumber="1" asp-route-searchString="@searchString"
               class="px-2.5 py-1.5 rounded-lg text-sm border border-slate-200 text-slate-500 hover:bg-slate-50 transition @(pageNumber == 1 ? "pointer-events-none opacity-40" : "")">
                <i class="bi bi-chevron-double-left"></i>
            </a>
            <a asp-action="@action" asp-route-pageNumber="@(pageNumber - 1)" asp-route-searchString="@searchString"
               class="px-2.5 py-1.5 rounded-lg text-sm border border-slate-200 text-slate-500 hover:bg-slate-50 transition @(pageNumber == 1 ? "pointer-events-none opacity-40" : "")">
                <i class="bi bi-chevron-left"></i>
            </a>

            @{
                var startPage = Math.Max(1, pageNumber - 4);
                var endPage = Math.Min(totalPages, pageNumber + 4);
            }

            @if (startPage > 1)
            {
                <span class="px-2 py-1.5 text-sm text-slate-400">...</span>
            }

            @for (int i = startPage; i <= endPage; i++)
            {
                <a asp-action="@action" asp-route-pageNumber="@i" asp-route-searchString="@searchString"
                   class="px-3 py-1.5 rounded-lg text-sm font-medium transition @(i == pageNumber ? "bg-primary-500 text-white" : "border border-slate-200 text-slate-600 hover:bg-primary-50 hover:text-primary-600")">
                    @i
                </a>
            }

            @if (endPage < totalPages)
            {
                <span class="px-2 py-1.5 text-sm text-slate-400">...</span>
            }

            <a asp-action="@action" asp-route-pageNumber="@(pageNumber + 1)" asp-route-searchString="@searchString"
               class="px-2.5 py-1.5 rounded-lg text-sm border border-slate-200 text-slate-500 hover:bg-slate-50 transition @(pageNumber == totalPages ? "pointer-events-none opacity-40" : "")">
                <i class="bi bi-chevron-right"></i>
            </a>
            <a asp-action="@action" asp-route-pageNumber="@totalPages" asp-route-searchString="@searchString"
               class="px-2.5 py-1.5 rounded-lg text-sm border border-slate-200 text-slate-500 hover:bg-slate-50 transition @(pageNumber == totalPages ? "pointer-events-none opacity-40" : "")">
                <i class="bi bi-chevron-double-right"></i>
            </a>
        </nav>
        <p class="text-xs text-slate-400">
            Pagina @pageNumber de @totalPages — @ViewBag.TotalRegistros registros
        </p>
    </div>
}
