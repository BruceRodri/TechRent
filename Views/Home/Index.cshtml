@{
    ViewData["Title"] = "Inicio - TechRent";
}

<div class="fade-in">
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-primary-600 via-primary-500 to-indigo-400 p-8 sm:p-12 mb-10 text-white">
        <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
        <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2"></div>
        <div class="relative z-10 text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white/15 backdrop-blur mb-4">
                <i class="bi bi-laptop text-3xl"></i>
            </div>
            <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-2">TechRent</h1>
            <p class="text-primary-100 text-lg mb-1">Sistema de Alquiler de Equipos Tecnologicos</p>
            <p class="text-primary-200 text-sm mb-6">Gestiona laptops, proyectores, camaras y mas</p>
            <div class="flex flex-wrap justify-center gap-3">
                <a asp-controller="Equipos" asp-action="Index"
                   class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white text-primary-600 font-semibold text-sm hover:bg-primary-50 transition shadow-lg">
                    <i class="bi bi-laptop"></i> Ver Equipos
                </a>
                <a asp-controller="Clientes" asp-action="Index"
                   class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white/15 text-white font-semibold text-sm hover:bg-white/25 transition backdrop-blur border border-white/20">
                    <i class="bi bi-people"></i> Ver Clientes
                </a>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
        <div class="bg-white rounded-xl p-5 border border-slate-100 hover:border-primary-200 transition group">
            <div class="w-10 h-10 rounded-lg bg-primary-50 flex items-center justify-center mb-3 group-hover:bg-primary-100 transition">
                <i class="bi bi-laptop text-primary-500"></i>
            </div>
            <h3 class="font-semibold text-slate-800 mb-1">Equipos Variados</h3>
            <p class="text-sm text-slate-500">Laptops, tablets, proyectores, camaras profesionales y equipos de audio</p>
        </div>
        <div class="bg-white rounded-xl p-5 border border-slate-100 hover:border-emerald-200 transition group">
            <div class="w-10 h-10 rounded-lg bg-emerald-50 flex items-center justify-center mb-3 group-hover:bg-emerald-100 transition">
                <i class="bi bi-currency-dollar text-emerald-500"></i>
            </div>
            <h3 class="font-semibold text-slate-800 mb-1">Precios Competitivos</h3>
            <p class="text-sm text-slate-500">Tarifas por dia adaptadas a tus necesidades con descuentos</p>
        </div>
        <div class="bg-white rounded-xl p-5 border border-slate-100 hover:border-rose-200 transition group">
            <div class="w-10 h-10 rounded-lg bg-rose-50 flex items-center justify-center mb-3 group-hover:bg-rose-100 transition">
                <i class="bi bi-calendar-check text-rose-500"></i>
            </div>
            <h3 class="font-semibold text-slate-800 mb-1">Reservas Rapidas</h3>
            <p class="text-sm text-slate-500">Sistema agil de reservas con seguimiento en tiempo real</p>
        </div>
    </div>

    <div id="statsSection">
        <h2 class="text-lg font-semibold text-slate-700 mb-4 flex items-center gap-2">
            <i class="bi bi-graph-up text-primary-500"></i> Numeros
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
                <i class="bi bi-laptop text-primary-400 text-xl mb-2 block"></i>
                <h3 id="totalEquipos" class="text-2xl font-bold text-slate-800">-</h3>
                <p class="text-xs text-slate-500 mt-0.5">Equipos</p>
            </div>
            <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
                <i class="bi bi-people text-emerald-400 text-xl mb-2 block"></i>
                <h3 id="totalClientes" class="text-2xl font-bold text-slate-800">-</h3>
                <p class="text-xs text-slate-500 mt-0.5">Clientes</p>
            </div>
            <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
                <i class="bi bi-building text-rose-400 text-xl mb-2 block"></i>
                <h3 id="totalMarcas" class="text-2xl font-bold text-slate-800">-</h3>
                <p class="text-xs text-slate-500 mt-0.5">Marcas</p>
            </div>
            <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
                <i class="bi bi-tag text-indigo-400 text-xl mb-2 block"></i>
                <h3 id="totalCategorias" class="text-2xl font-bold text-slate-800">-</h3>
                <p class="text-xs text-slate-500 mt-0.5">Categorias</p>
            </div>
        </div>
    </div>
</div>

<script>
    async function loadStats() {
        try {
            const [equiposRes, clientesRes, marcasRes, categoriasRes] = await Promise.all([
                fetch('/Equipos/GetCount'),
                fetch('/Clientes/GetCount'),
                fetch('/Marcas/GetCount'),
                fetch('/Categorias/GetCount')
            ]);

            document.getElementById('totalEquipos').textContent = await equiposRes.text();
            document.getElementById('totalClientes').textContent = await clientesRes.text();
            document.getElementById('totalMarcas').textContent = await marcasRes.text();
            document.getElementById('totalCategorias').textContent = await categoriasRes.text();
        } catch (error) {
            document.getElementById('totalEquipos').textContent = '-';
            document.getElementById('totalClientes').textContent = '-';
            document.getElementById('totalMarcas').textContent = '-';
            document.getElementById('totalCategorias').textContent = '-';
        }
    }
    loadStats();
</script>
