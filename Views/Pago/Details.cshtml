@model TechRent.Models.TransaccionPago

@{
    ViewData["Title"] = "Detalle del Pago";

    var statusColors = Model.Estado == "Pagado" ? "emerald"
                     : Model.Estado == "Cancelado" ? "rose" : "amber";
}

<div class="max-w-lg mx-auto fade-in">
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="bg-@statusColors-500 px-6 py-5 text-center">
            <div class="w-12 h-12 rounded-2xl bg-white/15 flex items-center justify-center mx-auto mb-2">
                <i class="bi bi-receipt text-white text-xl"></i>
            </div>
            <h4 class="text-white font-semibold">Detalle del Pago</h4>
        </div>

        <div class="p-6">
            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <span class="text-xs text-slate-400 block">Orden</span>
                    <span class="text-sm font-semibold text-slate-700">#@Model.OrdenAlquilerId</span>
                </div>
                <div>
                    <span class="text-xs text-slate-400 block">Pasarela</span>
                    <span class="text-sm font-semibold text-slate-700">@Model.Proveedor</span>
                </div>
                <div>
                    <span class="text-xs text-slate-400 block">Estado</span>
                    <span class="inline-flex px-2 py-0.5 rounded-md bg-@statusColors-50 text-@statusColors-600 text-xs font-medium">@Model.Estado</span>
                </div>
                <div>
                    <span class="text-xs text-slate-400 block">Total</span>
                    <span class="text-lg font-bold text-emerald-600">$@((Model.MontoEnCentavos / 100m).ToString("0.00"))</span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ClientTransactionId))
            {
                <div class="bg-slate-50 rounded-xl px-4 py-3 mb-4">
                    <span class="text-xs text-slate-400 block mb-1">Transaccion cliente</span>
                    <code class="text-xs font-mono text-slate-600 break-all">@Model.ClientTransactionId</code>
                </div>
            }

            @if (Model.OrdenAlquiler?.Detalles != null && Model.OrdenAlquiler.Detalles.Any())
            {
                <div class="border-t border-slate-100 pt-4 mt-4">
                    <h5 class="text-sm font-semibold text-slate-700 mb-3">Detalle de la orden</h5>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="border-b border-slate-100">
                                    <th class="text-left py-2 font-medium text-slate-500">Equipo</th>
                                    <th class="text-left py-2 font-medium text-slate-500">Cant.</th>
                                    <th class="text-left py-2 font-medium text-slate-500">Dias</th>
                                    <th class="text-left py-2 font-medium text-slate-500">P/Dia</th>
                                    <th class="text-left py-2 font-medium text-slate-500">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.OrdenAlquiler.Detalles)
                                {
                                    <tr class="border-b border-slate-50">
                                        <td class="py-2 text-slate-700">@d.NombreEquipo</td>
                                        <td class="py-2 text-slate-600">@d.Cantidad</td>
                                        <td class="py-2 text-slate-600">@d.Dias</td>
                                        <td class="py-2 text-slate-600">$@d.PrecioPorDia.ToString("0.00")</td>
                                        <td class="py-2 font-medium text-slate-700">$@d.Subtotal.ToString("0.00")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if (Model.Proveedor == "PayPhone" && Model.Estado == "Pendiente" && !string.IsNullOrWhiteSpace(Model.PayphonePaymentUrl))
            {
                <a class="w-full inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-500 text-white text-sm font-medium hover:bg-emerald-600 transition shadow-sm mt-4"
                   href="@Model.PayphonePaymentUrl" target="_blank">
                    <i class="bi bi-credit-card"></i> Abrir link de pago PayPhone
                </a>
            }

            @if (Model.Estado == "Pagado")
            {
                <div class="bg-emerald-50 border border-emerald-200 text-emerald-600 rounded-xl px-4 py-3 mt-4 text-sm flex items-center gap-2">
                    <i class="bi bi-check-circle"></i> Pago confirmado correctamente.
                </div>
            }

            @if (User.IsInRole("Administrador") && Model.Estado == "Pendiente")
            {
                <a class="w-full inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-amber-500 text-white text-sm font-medium hover:bg-amber-600 transition shadow-sm mt-4"
                   asp-action="MarcarPagado" asp-route-id="@Model.Id">
                    <i class="bi bi-check2-circle"></i> Marcar como pagado (demo)
                </a>
            }
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="Carrito" asp-action="Index"
           class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-500 hover:border-slate-300 hover:text-slate-700 transition">
            <i class="bi bi-arrow-left"></i> Volver al carrito
        </a>
    </div>
</div>
