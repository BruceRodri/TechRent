@model TechRent.Models.OrdenAlquiler
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@{
    var paypalClientId = Configuration["PayPal:ClientId"];
    ViewData["Title"] = "Pago con PayPal";
}

<div class="max-w-lg mx-auto fade-in">
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="bg-gradient-to-r from-[#0070ba] to-[#005ea6] px-6 py-5 text-center">
            <div class="w-12 h-12 rounded-2xl bg-white/15 flex items-center justify-center mx-auto mb-2">
                <i class="bi bi-paypal text-white text-xl"></i>
            </div>
            <h4 class="text-white font-semibold">Pago con PayPal Sandbox</h4>
        </div>

        <div class="p-6">
            <div class="flex items-center justify-between bg-slate-50 rounded-xl px-4 py-3 mb-4">
                <div>
                    <span class="text-xs text-slate-400 block">Orden</span>
                    <span class="text-sm font-semibold text-slate-700">#@Model.Id</span>
                </div>
                <div class="text-right">
                    <span class="text-xs text-slate-400 block">Total</span>
                    <span class="text-lg font-bold text-emerald-600">$@Model.Total.ToString("0.00")</span>
                </div>
            </div>

            <div class="bg-primary-50 border border-primary-100 text-primary-700 rounded-xl px-4 py-3 mb-4 text-sm flex items-start gap-2">
                <i class="bi bi-info-circle mt-0.5"></i>
                <span>Boton oficial de PayPal embebido. Desde Sandbox puedes probar con cuenta Sandbox o tarjeta de prueba.</span>
            </div>

            <div id="paypal-button-container" class="mb-4"></div>
            <div id="paypal-message"></div>

            <a asp-controller="Carrito" asp-action="Index"
               class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-500 hover:border-slate-300 hover:text-slate-700 transition mt-2">
                <i class="bi bi-arrow-left"></i> Volver al carrito
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://www.paypal.com/sdk/js?client-id=@paypalClientId&currency=USD&components=buttons&enable-funding=card"></script>

    <script>
        let transaccionPagoId = 0;

        function showMessage(message, type) {
            var colors = { danger: 'rose', warning: 'amber', success: 'emerald' };
            var c = colors[type] || 'slate';
            document.getElementById('paypal-message').innerHTML =
                '<div class="bg-' + c + '-50 border border-' + c + '-200 text-' + c + '-600 rounded-xl px-4 py-3 text-sm flex items-center gap-2"><i class="bi bi-info-circle"></i> ' + message + '</div>';
        }

        paypal.Buttons({
            createOrder: function () {
                return fetch('/Pago/CreatePayPalButtonOrderJson?ordenId=@Model.Id', { method: 'POST' })
                    .then(r => r.json())
                    .then(data => {
                        if (!data.success) {
                            showMessage(data.message, 'danger');
                            throw new Error(data.message);
                        }
                        transaccionPagoId = data.transaccionPagoId;
                        return data.paypalOrderId;
                    });
            },
            onApprove: function (data) {
                return fetch('/Pago/CapturePayPalButtonOrderJson', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        paypalOrderId: data.orderID,
                        transaccionPagoId: transaccionPagoId
                    })
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = data.redirectUrl;
                    } else {
                        showMessage(data.message, 'danger');
                    }
                });
            },
            onCancel: function () {
                showMessage('Pago cancelado por el usuario.', 'warning');
            },
            onError: function (err) {
                console.error(err);
                showMessage('Ocurrio un error con PayPal.', 'danger');
            }
        }).render('#paypal-button-container');
    </script>
}
