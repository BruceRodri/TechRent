@model TechRent.Models.Equipo

@{
    ViewData["Title"] = "Detalle del Equipo";
}

<div class="fade-in">
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <div class="px-6 py-4 bg-gradient-to-r from-slate-700 to-slate-800">
                <h1 class="text-xl font-bold text-white">Detalle del Equipo</h1>
                <p class="text-slate-300 text-sm mt-1">Información completa del equipo</p>
            </div>
            <div class="p-6">
                <div class="space-y-3">
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500">Nombre</span>
                        <span class="text-sm text-slate-800">@Html.DisplayFor(model => model.Nombre)</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500">Descripción</span>
                        <span class="text-sm text-slate-800 text-right max-w-xs">@Html.DisplayFor(model => model.Descripcion)</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500">Precio por Día</span>
                        <span class="text-sm text-slate-800">@Html.DisplayFor(model => model.PrecioPorDia)</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500">Stock</span>
                        <span class="text-sm text-slate-800">@Html.DisplayFor(model => model.Stock)</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500">Especificaciones</span>
                        <span class="text-sm text-slate-800 text-right max-w-xs">@Html.DisplayFor(model => model.Especificaciones)</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500">Activo</span>
                        <span class="text-sm text-slate-800">@Html.DisplayFor(model => model.Activo)</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500">Fecha Creación</span>
                        <span class="text-sm text-slate-800">@Html.DisplayFor(model => model.FechaCreacion)</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500">Fecha Actualización</span>
                        <span class="text-sm text-slate-800">@Html.DisplayFor(model => model.FechaActualizacion)</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500">Categoría</span>
                        <span class="text-sm text-slate-800">@Html.DisplayFor(model => model.Categoria.Nombre)</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500">Marca</span>
                        <span class="text-sm text-slate-800">@Html.DisplayFor(model => model.Marca.Nombre)</span>
                    </div>
                </div>

                <div class="flex items-center justify-between pt-4 border-t border-slate-100 mt-6">
                    <a asp-action="Index" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-500 hover:border-slate-300 hover:text-slate-700 transition">
                        Volver
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="px-5 py-2.5 rounded-xl bg-primary-500 text-white text-sm font-semibold hover:bg-primary-600 transition shadow-sm">
                        Editar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
