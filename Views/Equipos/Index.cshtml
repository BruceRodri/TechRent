@model IEnumerable<TechRent.Models.Equipo>

@{
    ViewData["Title"] = "Equipos Tecnologicos";
}

<div class="fade-in">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                <i class="bi bi-laptop text-primary-500"></i> Equipos Tecnologicos
            </h1>
            <p class="text-sm text-slate-400">Gestion completa de equipos disponibles para alquiler</p>
        </div>
        @if (User.IsInRole("Administrador"))
        {
            <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary-500 text-white text-sm font-medium hover:bg-primary-600 transition shadow-sm">
                <i class="bi bi-plus-circle"></i> Nuevo Equipo
            </a>
        }
    </div>

    <div class="grid grid-cols-3 gap-4 mb-6">
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-laptop text-primary-400 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">@ViewBag.TotalRegistros</h3>
            <p class="text-xs text-slate-500">Registrados</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-tag text-emerald-400 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">@ViewBag.TotalStock</h3>
            <p class="text-xs text-slate-500">En Stock</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-currency-dollar text-rose-400 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">$@ViewBag.PrecioPromedio.ToString("0.00")</h3>
            <p class="text-xs text-slate-500">Precio Promedio/Dia</p>
        </div>
    </div>

    <form method="get" class="flex gap-2 mb-6">
        <input type="text" name="searchString" value="@ViewBag.SearchString"
               class="flex-1 px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition"
               placeholder="Buscar por nombre o descripcion..." />
        <button type="submit" class="px-4 py-2 rounded-xl bg-primary-500 text-white text-sm font-medium hover:bg-primary-600 transition"><i class="bi bi-search"></i> Buscar</button>
        <a asp-action="Index" class="px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-500 hover:bg-slate-50 transition"><i class="bi bi-x-circle"></i> Limpiar</a>
    </form>

    <div class="bg-white rounded-2xl border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-slate-100">
                        <th class="text-left px-4 py-3 font-medium text-slate-500"><i class="bi bi-image mr-1"></i> Equipo</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-500"><i class="bi bi-tag mr-1"></i> Categoria</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-500"><i class="bi bi-building mr-1"></i> Marca</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-500"><i class="bi bi-currency-dollar mr-1"></i> Precio/Dia</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-500"><i class="bi bi-box mr-1"></i> Stock</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-500"><i class="bi bi-gear mr-1"></i> Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition">
                            <td class="px-4 py-3">
                                <span class="font-medium text-slate-700 block">@item.Nombre</span>
                                <span class="text-xs text-slate-400">@(item.Descripcion?.Length > 50 ? item.Descripcion.Substring(0, 50) + "..." : item.Descripcion)</span>
                            </td>
                            <td class="px-4 py-3"><span class="inline-flex px-2 py-0.5 rounded-md bg-primary-50 text-primary-600 text-xs font-medium">@item.Categoria?.Nombre</span></td>
                            <td class="px-4 py-3 text-slate-600">@item.Marca?.Nombre</td>
                            <td class="px-4 py-3">
                                <span class="font-semibold text-emerald-600">$@item.PrecioPorDia.ToString("0.00")</span>
                                <span class="text-xs text-slate-400 block">/dia</span>
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-1">
                                    @if (item.Stock > 5)
                                    {
                                        <span class="inline-flex px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-600 text-xs font-medium">@item.Stock disp.</span>
                                    }
                                    else if (item.Stock > 0)
                                    {
                                        <span class="inline-flex px-2 py-0.5 rounded-md bg-amber-50 text-amber-600 text-xs font-medium">@item.Stock disp.</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex px-2 py-0.5 rounded-md bg-rose-50 text-rose-600 text-xs font-medium">Agotado</span>
                                    }
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <button type="button" class="p-1 rounded text-slate-400 hover:text-primary-500 hover:bg-primary-50 transition"
                                                onclick="abrirAjusteStock(@item.Id, '@item.Nombre.Replace("'", "\\'")', @item.Stock)" title="Ajustar stock">
                                            <i class="bi bi-sliders text-xs"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-1">
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="p-1.5 rounded-lg text-primary-500 hover:bg-primary-50 transition" title="Editar"><i class="bi bi-pencil text-sm"></i></a>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.Id" class="p-1.5 rounded-lg text-slate-400 hover:bg-slate-100 transition" title="Ver"><i class="bi bi-eye text-sm"></i></a>
                                    @if (item.Stock > 0)
                                    {
                                        <button type="button" class="p-1.5 rounded-lg text-emerald-500 hover:bg-emerald-50 transition" title="Agregar al carrito"
                                                onclick="agregarAlCarrito(@item.Id, this, '@item.Nombre.Replace("'", "\\'")', @item.Stock)">
                                            <i class="bi bi-cart-plus text-sm"></i>
                                        </button>
                                    }
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="p-1.5 rounded-lg text-rose-400 hover:bg-rose-50 transition" title="Eliminar"><i class="bi bi-trash text-sm"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @await Html.PartialAsync("_Pagination")
</div>

@if (User.IsInRole("Administrador"))
{
    <div id="modalAjusteStock" class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 hidden">
        <div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-sm mx-4">
            <h3 class="text-lg font-bold text-slate-800 mb-1"><i class="bi bi-sliders text-primary-500"></i> Ajustar Stock</h3>
            <p class="text-sm text-slate-500 mb-4">Equipo: <span id="ajusteNombre" class="font-medium text-slate-700"></span> &mdash; Stock actual: <span id="ajusteStockActual" class="font-semibold"></span></p>
            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-slate-500 mb-1">Cantidad (+ para agregar, - para restar)</label>
                    <input id="ajusteCantidad" type="number" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100" placeholder="Ej: 10 o -5" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-500 mb-1">Observacion (opcional)</label>
                    <input id="ajusteObs" type="text" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100" placeholder="Motivo del ajuste" />
                </div>
            </div>
            <div class="flex justify-end gap-2 mt-5">
                <button onclick="cerrarAjusteStock()" class="px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-500 hover:bg-slate-50">Cancelar</button>
                <button onclick="confirmarAjusteStock()" class="px-4 py-2 rounded-xl bg-primary-500 text-white text-sm font-medium hover:bg-primary-600 transition">Aplicar</button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function showToast(message, type) {
            var toast = document.createElement('div');
            toast.className = 'fixed bottom-6 right-6 z-50 px-5 py-3 rounded-xl shadow-lg text-sm font-medium flex items-center gap-2 transition transform translate-y-0 opacity-100 ' +
                (type === 'success' ? 'bg-emerald-600 text-white' : 'bg-rose-600 text-white');
            toast.innerHTML = '<i class="bi ' + (type === 'success' ? 'bi-check-circle' : 'bi-exclamation-circle') + '"></i> ' + message;
            document.body.appendChild(toast);
            setTimeout(function() {
                toast.classList.add('translate-y-2', 'opacity-0');
                setTimeout(function() { toast.remove(); }, 300);
            }, 3000);
        }

        function agregarAlCarrito(equipoId, btn, nombre, stock) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            fetch('/Carrito/AgregarJson', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body: 'equipoId=' + equipoId + '&cantidad=1&dias=1'
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    btn.innerHTML = '<i class="bi bi-check-lg text-sm"></i>';
                    setTimeout(function() { btn.innerHTML = '<i class="bi bi-cart-plus text-sm"></i>'; }, 1500);
                    var badge = document.getElementById('cart-count');
                    if (badge) { badge.textContent = data.count; badge.style.display = 'flex'; }
                    showToast(nombre + ' agregado. Stock disponible: ' + stock, 'success');
                } else { alert(data.message); }
            })
            .catch(function() { alert('Error al agregar al carrito.'); });
        }

        var _ajusteEquipoId = 0;

        function abrirAjusteStock(equipoId, nombre, stockActual) {
            _ajusteEquipoId = equipoId;
            document.getElementById('ajusteNombre').textContent = nombre;
            document.getElementById('ajusteStockActual').textContent = stockActual;
            document.getElementById('ajusteCantidad').value = '';
            document.getElementById('ajusteObs').value = '';
            document.getElementById('modalAjusteStock').classList.remove('hidden');
        }

        function cerrarAjusteStock() {
            document.getElementById('modalAjusteStock').classList.add('hidden');
        }

        function confirmarAjusteStock() {
            var cantidad = parseInt(document.getElementById('ajusteCantidad').value, 10);
            if (isNaN(cantidad) || cantidad === 0) {
                alert('Ingrese una cantidad valida.');
                return;
            }
            var obs = document.getElementById('ajusteObs').value;
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            fetch('/Equipos/AjustarStock', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body: 'id=' + _ajusteEquipoId + '&cantidad=' + cantidad + '&observacion=' + encodeURIComponent(obs)
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    showToast(data.message, 'success');
                    cerrarAjusteStock();
                    setTimeout(function() { location.reload(); }, 800);
                } else { alert(data.message); }
            })
            .catch(function() { alert('Error al ajustar stock.'); });
        }
    </script>
}
