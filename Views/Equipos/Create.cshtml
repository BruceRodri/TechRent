@model TechRent.Models.Equipo

@{
    ViewData["Title"] = "Nuevo Equipo";
}

<div class="fade-in">
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <div class="px-6 py-4 bg-gradient-to-r from-primary-500 to-primary-600">
                <h1 class="text-xl font-bold text-white">Registrar Nuevo Equipo</h1>
                <p class="text-primary-100 text-sm mt-1">Complete los datos del equipo a registrar</p>
            </div>
            <div class="p-6">
                <form asp-action="Create">
                    <div asp-validation-summary="All" class="bg-rose-50 border border-rose-200 text-rose-600 text-sm rounded-xl px-4 py-3 mb-4"></div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label asp-for="Nombre" class="block text-sm font-medium text-slate-600 mb-1.5">Nombre del Equipo</label>
                            <input asp-for="Nombre" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" placeholder="Ej: Laptop HP Pavilion" />
                            <span asp-validation-for="Nombre" class="text-rose-500 text-xs mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="Stock" class="block text-sm font-medium text-slate-600 mb-1.5">Cantidad en Stock</label>
                            <input asp-for="Stock" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" type="number" min="0" />
                            <span asp-validation-for="Stock" class="text-rose-500 text-xs mt-1 block"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Descripcion" class="block text-sm font-medium text-slate-600 mb-1.5">Descripción</label>
                        <textarea asp-for="Descripcion" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" rows="3" placeholder="Especificaciones técnicas del equipo..."></textarea>
                        <span asp-validation-for="Descripcion" class="text-rose-500 text-xs mt-1 block"></span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                        <div>
                            <label asp-for="PrecioPorDia" class="block text-sm font-medium text-slate-600 mb-1.5">Precio por Día ($)</label>
                            <input asp-for="PrecioPorDia" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" type="number" step="0.01" />
                            <span asp-validation-for="PrecioPorDia" class="text-rose-500 text-xs mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="CategoriaId" class="block text-sm font-medium text-slate-600 mb-1.5">Categoría</label>
                            <select asp-for="CategoriaId" asp-items="ViewBag.CategoriaId" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" data-val="false">
                                <option value="">Seleccione...</option>
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-rose-500 text-xs mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="MarcaId" class="block text-sm font-medium text-slate-600 mb-1.5">Marca</label>
                            <select asp-for="MarcaId" asp-items="ViewBag.MarcaId" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition">
                                <option value="">Seleccione...</option>
                            </select>
                            <span asp-validation-for="MarcaId" class="text-rose-500 text-xs mt-1 block"></span>
                        </div>
                    </div>

                    <div class="mb-6">
                        <label asp-for="Especificaciones" class="block text-sm font-medium text-slate-600 mb-1.5">Especificaciones Técnicas</label>
                        <textarea asp-for="Especificaciones" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" rows="2" placeholder="Procesador, RAM, almacenamiento, etc."></textarea>
                    </div>

                    <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                        <a asp-action="Index" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-500 hover:border-slate-300 hover:text-slate-700 transition">
                            Cancelar
                        </a>
                        <button type="submit" class="px-5 py-2.5 rounded-xl bg-primary-500 text-white text-sm font-semibold hover:bg-primary-600 transition shadow-sm">
                            Guardar Equipo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
