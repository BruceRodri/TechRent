@model IEnumerable<TechRent.Models.CarritoItem>

@{
    ViewData["Title"] = "Mi Carrito";
}

<div class="fade-in">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                <i class="bi bi-cart3 text-primary-500"></i> Mi Carrito
            </h1>
            <p class="text-sm text-slate-400">Equipos seleccionados para alquiler</p>
        </div>
        <a asp-controller="Equipos" asp-action="Index"
           class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-600 hover:border-primary-300 hover:text-primary-600 transition">
            <i class="bi bi-arrow-left"></i> Seguir agregando
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="bg-rose-50 border border-rose-200 text-rose-700 rounded-xl px-4 py-3 mb-4 flex items-center gap-2 text-sm">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        </div>
    }
    @if (TempData["Exito"] != null)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl px-4 py-3 mb-4 flex items-center gap-2 text-sm">
            <i class="bi bi-check-circle"></i> @TempData["Exito"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="bg-white rounded-2xl border border-slate-100 p-12 text-center">
            <div class="w-16 h-16 rounded-2xl bg-slate-100 flex items-center justify-center mx-auto mb-4">
                <i class="bi bi-cart-x text-slate-300 text-2xl"></i>
            </div>
            <h3 class="text-lg font-semibold text-slate-600 mb-1">Tu carrito esta vacio</h3>
            <p class="text-sm text-slate-400 mb-4">Explora nuestro catalogo y agrega equipos para alquilar.</p>
            <a asp-controller="Equipos" asp-action="Index"
               class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary-500 text-white text-sm font-medium hover:bg-primary-600 transition shadow-sm">
                <i class="bi bi-laptop"></i> Ver Equipos
            </a>
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl border border-slate-100 overflow-hidden mb-4">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-slate-100">
                            <th class="text-left px-4 py-3 font-medium text-slate-500"><i class="bi bi-laptop mr-1"></i> Equipo</th>
                            <th class="text-left px-4 py-3 font-medium text-slate-500"><i class="bi bi-tag mr-1"></i> Categoria</th>
                            <th class="text-left px-4 py-3 font-medium text-slate-500"><i class="bi bi-currency-dollar mr-1"></i> Precio/Dia</th>
                            <th class="text-left px-4 py-3 font-medium text-slate-500"><i class="bi bi-box mr-1"></i> Stock</th>
                            <th class="text-left px-4 py-3 font-medium text-slate-500"><i class="bi bi-hash mr-1"></i> Cantidad</th>
                            <th class="text-left px-4 py-3 font-medium text-slate-500"><i class="bi bi-calendar mr-1"></i> Dias</th>
                            <th class="text-left px-4 py-3 font-medium text-slate-500"><i class="bi bi-calculator mr-1"></i> Subtotal</th>
                            <th class="text-left px-4 py-3 font-medium text-slate-500"><i class="bi bi-gear mr-1"></i> Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition" data-item-id="@item.Id">
                                <td class="px-4 py-3">
                                    <span class="font-medium text-slate-700 block">@item.Equipo.Nombre</span>
                                    <span class="text-xs text-slate-400">@item.Equipo.Marca?.Nombre</span>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="inline-flex px-2 py-0.5 rounded-md bg-primary-50 text-primary-600 text-xs font-medium">@item.Equipo.Categoria?.Nombre</span>
                                </td>
                                <td class="px-4 py-3 text-slate-600">$@item.Equipo.PrecioPorDia.ToString("0.00")</td>
                                <td class="px-4 py-3">
                                    @if (item.Equipo.Stock > 5)
                                    {
                                        <span class="inline-flex px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-600 text-xs font-medium">@item.Equipo.Stock disp.</span>
                                    }
                                    else if (item.Equipo.Stock > 0)
                                    {
                                        <span class="inline-flex px-2 py-0.5 rounded-md bg-amber-50 text-amber-600 text-xs font-medium">@item.Equipo.Stock disp.</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex px-2 py-0.5 rounded-md bg-rose-50 text-rose-600 text-xs font-medium">Agotado</span>
                                    }
                                </td>
                                <td class="px-4 py-3">
                                    <input type="number" value="@item.Cantidad" min="1" max="@item.Equipo.Stock"
                                           class="cart-cantidad w-16 px-2 py-1 rounded-lg border border-slate-200 text-xs text-slate-700 focus:outline-none focus:border-primary-400 transition"
                                           data-id="@item.Id" data-precio="@item.Equipo.PrecioPorDia" data-stock="@item.Equipo.Stock" />
                                </td>
                                <td class="px-4 py-3">
                                    <input type="number" value="@item.Dias" min="1" max="365"
                                           class="cart-dias w-16 px-2 py-1 rounded-lg border border-slate-200 text-xs text-slate-700 focus:outline-none focus:border-primary-400 transition"
                                           data-id="@item.Id" />
                                </td>
                                <td class="px-4 py-3">
                                    <span class="font-semibold text-emerald-600 cart-subtotal" data-id="@item.Id">$@((item.Cantidad * item.Equipo.PrecioPorDia * item.Dias).ToString("0.00"))</span>
                                </td>
                                <td class="px-4 py-3">
                                    <form asp-action="Eliminar" method="post" class="inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="p-1.5 rounded-lg text-rose-400 hover:bg-rose-50 transition" title="Eliminar">
                                            <i class="bi bi-trash text-sm"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
            <div class="sm:w-1/2">
                <form asp-action="Vaciar" method="post">
                    <button type="submit"
                            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl border border-rose-200 text-sm font-medium text-rose-600 hover:bg-rose-50 transition">
                        <i class="bi bi-trash3"></i> Vaciar Carrito
                    </button>
                </form>
            </div>
            <div class="sm:w-1/2">
                <div class="bg-slate-50 rounded-xl border border-slate-200 p-5">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-sm font-medium text-slate-500">Total</span>
                        <span class="text-xl font-bold text-emerald-600" id="cartTotal">$@ViewBag.Total.ToString("0.00")</span>
                    </div>
                    <form asp-controller="Carrito" asp-action="ConfirmarReserva" method="post" class="mb-2">
                        <input type="hidden" name="metodoPago" value="PayPal" />
                        <button type="submit"
                                class="w-full inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-[#0070ba] text-white text-sm font-medium hover:bg-[#005ea6] transition shadow-sm">
                            <i class="bi bi-paypal"></i> Pagar con PayPal
                        </button>
                    </form>
                    <form asp-controller="Carrito" asp-action="ConfirmarReserva" method="post">
                        <input type="hidden" name="metodoPago" value="PayPhone" />
                        <button type="submit"
                                class="w-full inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-500 text-white text-sm font-medium hover:bg-emerald-600 transition shadow-sm">
                            <i class="bi bi-phone"></i> Pagar con PayPhone
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        function sendUpdate(id, cantidad, dias) {
            fetch('/Carrito/ActualizarJson', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `id=${id}&cantidad=${cantidad}&dias=${dias}`
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    const subEl = document.querySelector(`.cart-subtotal[data-id="${id}"]`);
                    if (subEl) subEl.textContent = '$' + data.subtotal.toFixed(2);

                    const totalEl = document.getElementById('cartTotal');
                    if (totalEl) totalEl.textContent = '$' + data.total.toFixed(2);
                } else {
                    alert(data.message);
                }
            });
        }

        document.querySelectorAll('.cart-cantidad').forEach(input => {
            let timeout;
            input.addEventListener('input', function() {
                clearTimeout(timeout);
                const id = this.dataset.id;
                const stock = parseInt(this.dataset.stock);
                let val = parseInt(this.value) || 1;
                if (val < 1) val = 1;
                if (val > stock) val = stock;

                const row = this.closest('tr');
                const diasInput = row.querySelector('.cart-dias');
                const dias = parseInt(diasInput.value) || 1;

                timeout = setTimeout(() => sendUpdate(id, val, dias), 300);
            });
        });

        document.querySelectorAll('.cart-dias').forEach(input => {
            let timeout;
            input.addEventListener('input', function() {
                clearTimeout(timeout);
                const id = this.dataset.id;
                let val = parseInt(this.value) || 1;
                if (val < 1) val = 1;
                if (val > 365) val = 365;

                const row = this.closest('tr');
                const cantidadInput = row.querySelector('.cart-cantidad');
                const cantidad = parseInt(cantidadInput.value) || 1;

                timeout = setTimeout(() => sendUpdate(id, cantidad, val), 300);
            });
        });
    </script>
}
