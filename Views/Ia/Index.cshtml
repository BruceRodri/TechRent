@{
    ViewData["Title"] = "Asistente IA";
}

<div class="max-w-2xl mx-auto fade-in">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="bg-gradient-to-r from-primary-500 to-indigo-500 px-6 py-4 text-center">
            <h4 class="text-white font-semibold mb-0.5 flex items-center justify-center gap-2">
                <i class="bi bi-robot"></i> TechRent AI
            </h4>
            <p class="text-primary-100 text-sm">Describe lo que necesitas y te recomendamos los mejores equipos</p>
        </div>

        <div class="p-4">
            <div id="chat" class="bg-slate-50 rounded-xl p-4 mb-4 space-y-3" style="height: 400px; overflow-y: auto;">
                <div id="bienvenida" class="flex items-center justify-center h-full">
                    <div class="text-center">
                        <div class="w-14 h-14 rounded-2xl bg-primary-100 flex items-center justify-center mx-auto mb-3">
                            <i class="bi bi-chat-dots text-primary-400 text-2xl"></i>
                        </div>
                        <p class="text-slate-400 text-sm">Ejemplo: "Necesito equipo para grabar un video profesional"</p>
                    </div>
                </div>
            </div>

            <div class="flex gap-2">
                <input type="text" id="mensaje"
                       class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition"
                       placeholder="Escribe tu consulta aqui..."
                       onkeypress="if(event.key==='Enter') enviar()" />
                <button onclick="enviar()" id="btnEnviar"
                        class="px-5 py-2.5 rounded-xl bg-primary-500 text-white text-sm font-medium hover:bg-primary-600 transition shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
                    <i class="bi bi-send"></i> Enviar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function enviar() {
            var input = document.getElementById('mensaje');
            var mensaje = input.value.trim();
            if (!mensaje) return;

            var chat = document.getElementById('chat');
            var bienvenida = document.getElementById('bienvenida');
            if (bienvenida) bienvenida.remove();

            chat.innerHTML += '<div class="flex justify-end"><div class="bg-primary-500 text-white text-sm px-4 py-2.5 rounded-2xl rounded-br-md max-w-[80%]">' + mensaje + '</div></div>';
            input.value = '';

            chat.innerHTML += '<div id="cargando" class="flex justify-start"><div class="bg-slate-200 text-slate-500 text-sm px-4 py-2.5 rounded-2xl rounded-bl-md"><i class="bi bi-hourglass-split"></i> Pensando...</div></div>';
            chat.scrollTop = chat.scrollHeight;

            document.getElementById('btnEnviar').disabled = true;

            fetch('/Ia/Generar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'mensaje=' + encodeURIComponent(mensaje)
            })
            .then(function(response) { return response.json(); })
            .then(function(data) {
                var cargando = document.getElementById('cargando');
                if (cargando) cargando.remove();

                chat.innerHTML += '<div class="flex justify-start"><div class="bg-emerald-50 text-emerald-700 border border-emerald-100 text-sm px-4 py-2.5 rounded-2xl rounded-bl-md max-w-[80%] whitespace-pre-wrap">' + data.respuesta + '</div></div>';
                chat.scrollTop = chat.scrollHeight;
                document.getElementById('btnEnviar').disabled = false;
            })
            .catch(function() {
                var cargando = document.getElementById('cargando');
                if (cargando) cargando.remove();

                chat.innerHTML += '<div class="flex justify-start"><div class="bg-rose-50 text-rose-600 border border-rose-100 text-sm px-4 py-2.5 rounded-2xl rounded-bl-md">Error al conectar con Ollama</div></div>';
                chat.scrollTop = chat.scrollHeight;
                document.getElementById('btnEnviar').disabled = false;
            });
        }
    </script>
}
