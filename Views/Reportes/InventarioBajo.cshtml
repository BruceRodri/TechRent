@model IEnumerable<TechRent.Models.Equipo>

@{
    ViewData["Title"] = "Inventario Bajo";
}

<div class="fade-in">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
            <i class="bi bi-box-seam text-rose-500"></i> Productos con Bajo Inventario
        </h1>
        <p class="text-sm text-slate-400">Equipos con stock igual o menor al umbral configurado</p>
    </div>

    <div class="bg-white rounded-xl p-4 border border-slate-100 text-center mb-6">
        <h3 class="text-2xl font-bold text-rose-600">@Model.Count()</h3>
        <p class="text-xs text-slate-500">Productos con stock bajo</p>
    </div>

    <form method="get" class="flex gap-2 mb-6 flex-wrap">
        <div class="flex items-center gap-1">
            <label class="text-sm text-slate-500">Umbral:</label>
            <input type="number" name="umbral" value="@ViewBag.Umbral" min="1" max="100"
                   class="px-3 py-2 rounded-xl border border-slate-200 text-sm text-slate-700 focus:outline-none focus:border-primary-400 w-20" />
        </div>
        <select name="categoriaId" class="px-3 py-2 rounded-xl border border-slate-200 text-sm text-slate-700 focus:outline-none focus:border-primary-400">
            <option value="">Todas las categorias</option>
            @foreach (var cat in (IEnumerable<TechRent.Models.Categoria>)ViewBag.Categorias)
            {
                <option value="@cat.Id" selected="@(ViewBag.CategoriaId != null && (int)ViewBag.CategoriaId == cat.Id)">@cat.Nombre</option>
            }
        </select>
        <select name="marcaId" class="px-3 py-2 rounded-xl border border-slate-200 text-sm text-slate-700 focus:outline-none focus:border-primary-400">
            <option value="">Todas las marcas</option>
            @foreach (var m in (IEnumerable<TechRent.Models.Marca>)ViewBag.Marcas)
            {
                <option value="@m.Id" selected="@(ViewBag.MarcaId != null && (int)ViewBag.MarcaId == m.Id)">@m.Nombre</option>
            }
        </select>
        <button type="submit" class="px-4 py-2 rounded-xl bg-primary-500 text-white text-sm font-medium hover:bg-primary-600 transition">
            <i class="bi bi-search"></i> Filtrar
        </button>
        <a asp-action="InventarioBajo" class="px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-500 hover:bg-slate-50 transition">
            <i class="bi bi-x-circle"></i> Limpiar
        </a>
    </form>

    <div class="bg-white rounded-2xl border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-slate-100">
                        <th class="text-left px-5 py-3 font-medium text-slate-500">Equipo</th>
                        <th class="text-left px-5 py-3 font-medium text-slate-500">Categoria</th>
                        <th class="text-left px-5 py-3 font-medium text-slate-500">Marca</th>
                        <th class="text-left px-5 py-3 font-medium text-slate-500">Stock</th>
                        <th class="text-left px-5 py-3 font-medium text-slate-500">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-4 py-8 text-center text-slate-400">
                                <i class="bi bi-check-circle text-3xl mb-2 block text-emerald-400"></i>
                                Todos los equipos tienen stock suficiente.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        var stockColor = item.Stock == 0 ? "bg-red-100 text-red-700" :
                                         item.Stock <= 2 ? "bg-rose-100 text-rose-700" :
                                         "bg-amber-100 text-amber-700";
                        var estado = item.Stock == 0 ? "Sin Stock" :
                                     item.Stock <= 2 ? "Critico" : "Bajo";
                        <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition">
                            <td class="px-5 py-3 font-medium text-slate-700">@item.Nombre</td>
                            <td class="px-5 py-3 text-slate-500">@item.Categoria.Nombre</td>
                            <td class="px-5 py-3 text-slate-500">@item.Marca.Nombre</td>
                            <td class="px-5 py-3">
                                <span class="inline-flex px-2.5 py-0.5 rounded-md @stockColor text-xs font-bold">@item.Stock</span>
                            </td>
                            <td class="px-5 py-3">
                                <span class="inline-flex px-2.5 py-0.5 rounded-md @stockColor text-xs font-medium">@estado</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
