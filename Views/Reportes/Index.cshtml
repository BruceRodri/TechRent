@{
    ViewData["Title"] = "Reportes";
}

<div class="fade-in">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
            <i class="bi bi-bar-chart-fill text-primary-500"></i> Panel de Reportes
        </h1>
        <p class="text-sm text-slate-400">Indicadores y estadisticas del sistema TechRent</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-laptop text-primary-400 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">@ViewBag.TotalEquipos</h3>
            <p class="text-xs text-slate-500">Equipos</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-people-fill text-emerald-400 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">@ViewBag.TotalClientes</h3>
            <p class="text-xs text-slate-500">Clientes</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-calendar-check text-rose-400 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">@ViewBag.TotalReservas</h3>
            <p class="text-xs text-slate-500">Reservas</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-currency-dollar text-indigo-400 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">$@ViewBag.SumaTotalReservas.ToString("0.00")</h3>
            <p class="text-xs text-slate-500">Total Ventas</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-graph-up-arrow text-amber-500 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">$@ViewBag.PromedioVentas.ToString("0.00")</h3>
            <p class="text-xs text-slate-500">Promedio/Reserva</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-tags-fill text-emerald-500 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">@ViewBag.TotalCategorias</h3>
            <p class="text-xs text-slate-500">Categorias</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-building text-sky-500 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">@ViewBag.TotalMarcas</h3>
            <p class="text-xs text-slate-500">Marcas</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-100 overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100">
            <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2">
                <i class="bi bi-trophy text-amber-400"></i> Top 5 Equipos Mas Alquilados
            </h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-slate-100">
                        <th class="text-left px-5 py-3 font-medium text-slate-500">#</th>
                        <th class="text-left px-5 py-3 font-medium text-slate-500">Equipo</th>
                        <th class="text-left px-5 py-3 font-medium text-slate-500">Veces Alquilado</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var equipos = ViewBag.EquiposMasAlquilados;
                        if (equipos != null)
                        {
                            int i = 1;
                            foreach (var item in equipos)
                            {
                                <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition">
                                    <td class="px-5 py-3 text-slate-400 font-medium">@i</td>
                                    <td class="px-5 py-3 font-medium text-slate-700">@item.Nombre</td>
                                    <td class="px-5 py-3 font-bold text-primary-600">@item.TotalAlquileres</td>
                                </tr>
                                i++;
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
