@{
    ViewData["Title"] = "Reportes";
}

<div class="fade-in">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                <i class="bi bi-bar-chart-fill text-primary-500"></i> Panel de Reportes
            </h1>
            <p class="text-sm text-slate-400">Indicadores y estadisticas del sistema TechRent</p>
        </div>
    </div>

    <!-- Resumen general -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-laptop text-primary-400 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">@ViewBag.TotalEquipos</h3>
            <p class="text-xs text-slate-500">Equipos</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-people-fill text-emerald-400 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">@ViewBag.TotalClientes</h3>
            <p class="text-xs text-slate-500">Clientes</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-calendar-check text-rose-400 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">@ViewBag.TotalReservas</h3>
            <p class="text-xs text-slate-500">Reservas</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-currency-dollar text-indigo-400 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">$@ViewBag.SumaTotalReservas.ToString("0.00")</h3>
            <p class="text-xs text-slate-500">Total Ventas</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-graph-up-arrow text-amber-500 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">$@ViewBag.PromedioVentas.ToString("0.00")</h3>
            <p class="text-xs text-slate-500">Promedio/Reserva</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-tags-fill text-emerald-500 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">@ViewBag.TotalCategorias</h3>
            <p class="text-xs text-slate-500">Categorias</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-building text-sky-500 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">@ViewBag.TotalMarcas</h3>
            <p class="text-xs text-slate-500">Marcas</p>
        </div>
    </div>

    <!-- Top 5 equipos mas alquilados -->
    <div class="bg-white rounded-2xl border border-slate-100 overflow-hidden mb-6">
        <div class="px-5 py-4 border-b border-slate-100">
            <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2">
                <i class="bi bi-trophy text-amber-400"></i> Top 5 Equipos Mas Alquilados
            </h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-slate-100">
                        <th class="text-left px-5 py-3 font-medium text-slate-500">#</th>
                        <th class="text-left px-5 py-3 font-medium text-slate-500">Equipo</th>
                        <th class="text-left px-5 py-3 font-medium text-slate-500">Veces Alquilado</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var equipos = ViewBag.EquiposMasAlquilados;
                        if (equipos != null)
                        {
                            int i = 1;
                            foreach (var item in equipos)
                            {
                                <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition">
                                    <td class="px-5 py-3 text-slate-400 font-medium">@i</td>
                                    <td class="px-5 py-3 font-medium text-slate-700">@item.Nombre</td>
                                    <td class="px-5 py-3 font-bold text-primary-600">@item.TotalAlquileres</td>
                                </tr>
                                i++;
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Links a reportes -->
    <div class="mb-4">
        <h2 class="text-sm font-semibold text-slate-700 mb-3 flex items-center gap-2">
            <i class="bi bi-list-check text-primary-400"></i> Reportes Disponibles
        </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <a asp-action="Transacciones" class="bg-white rounded-xl p-5 border border-slate-100 hover:border-primary-300 hover:shadow-md transition group">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center group-hover:bg-blue-100 transition">
                    <i class="bi bi-credit-card text-blue-500"></i>
                </div>
                <h3 class="font-semibold text-slate-700">Pagos por Pasarela</h3>
            </div>
            <p class="text-xs text-slate-400">Resumen de transacciones por PayPal y PayPhone con filtros por estado y fecha.</p>
        </a>

        <a asp-action="VentasPorFecha" class="bg-white rounded-xl p-5 border border-slate-100 hover:border-primary-300 hover:shadow-md transition group">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center group-hover:bg-emerald-100 transition">
                    <i class="bi bi-calendar-range text-emerald-500"></i>
                </div>
                <h3 class="font-semibold text-slate-700">Ventas por Fecha</h3>
            </div>
            <p class="text-xs text-slate-400">Reservas agrupadas por dia, semana o mes con rango de fechas configurable.</p>
        </a>

        <a asp-action="IngresosPorMes" class="bg-white rounded-xl p-5 border border-slate-100 hover:border-primary-300 hover:shadow-md transition group">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center group-hover:bg-indigo-100 transition">
                    <i class="bi bi-cash-stack text-indigo-500"></i>
                </div>
                <h3 class="font-semibold text-slate-700">Ingresos por Mes</h3>
            </div>
            <p class="text-xs text-slate-400">Resumen mensual de reservas, montos totales y promedio por reserva.</p>
        </a>

        <a asp-action="ClientesTopCompras" class="bg-white rounded-xl p-5 border border-slate-100 hover:border-primary-300 hover:shadow-md transition group">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center group-hover:bg-amber-100 transition">
                    <i class="bi bi-trophy text-amber-500"></i>
                </div>
                <h3 class="font-semibold text-slate-700">Clientes Top Compras</h3>
            </div>
            <p class="text-xs text-slate-400">Ranking de clientes por numero de reservas y monto total gastado.</p>
        </a>

        <a asp-action="InventarioBajo" class="bg-white rounded-xl p-5 border border-slate-100 hover:border-primary-300 hover:shadow-md transition group">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-rose-50 flex items-center justify-center group-hover:bg-rose-100 transition">
                    <i class="bi bi-box-seam text-rose-500"></i>
                </div>
                <h3 class="font-semibold text-slate-700">Inventario Bajo</h3>
            </div>
            <p class="text-xs text-slate-400">Equipos con stock critico, filtrables por umbral, categoria y marca.</p>
        </a>

        <a asp-action="IntentosAccesoFallidos" class="bg-white rounded-xl p-5 border border-slate-100 hover:border-primary-300 hover:shadow-md transition group">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-red-50 flex items-center justify-center group-hover:bg-red-100 transition">
                    <i class="bi bi-shield-lock text-red-500"></i>
                </div>
                <h3 class="font-semibold text-slate-700">Accesos Fallidos</h3>
            </div>
            <p class="text-xs text-slate-400">Registro de accesos denegados y cuentas bloqueadas con filtros por fecha.</p>
        </a>

        <a asp-action="TiempoPromedioIA" class="bg-white rounded-xl p-5 border border-slate-100 hover:border-primary-300 hover:shadow-md transition group">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-purple-50 flex items-center justify-center group-hover:bg-purple-100 transition">
                    <i class="bi bi-robot text-purple-500"></i>
                </div>
                <h3 class="font-semibold text-slate-700">Tiempo Respuesta IA</h3>
            </div>
            <p class="text-xs text-slate-400">Metricas de rendimiento del modelo Ollama: promedio, minimo y maximo.</p>
        </a>

        <a asp-controller="MovimientosInventario" asp-action="Index" class="bg-white rounded-xl p-5 border border-slate-100 hover:border-primary-300 hover:shadow-md transition group">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-sky-50 flex items-center justify-center group-hover:bg-sky-100 transition">
                    <i class="bi bi-arrow-left-right text-sky-500"></i>
                </div>
                <h3 class="font-semibold text-slate-700">Movimientos Inventario</h3>
            </div>
            <p class="text-xs text-slate-400">Historial de movimientos de stock con filtros por equipo y tipo de movimiento.</p>
        </a>

        <a asp-controller="Bitacora" asp-action="Index" class="bg-white rounded-xl p-5 border border-slate-100 hover:border-primary-300 hover:shadow-md transition group">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center group-hover:bg-slate-100 transition">
                    <i class="bi bi-journal-text text-slate-500"></i>
                </div>
                <h3 class="font-semibold text-slate-700">Bitacora / Auditoria</h3>
            </div>
            <p class="text-xs text-slate-400">Registro completo de acciones del sistema con filtros por email, accion y fecha.</p>
        </a>
    </div>
</div>
