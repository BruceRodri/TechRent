@{
    ViewData["Title"] = "Clientes Top Compras";
}

<div class="fade-in">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
            <i class="bi bi-trophy text-primary-500"></i> Clientes con Mayor Cantidad de Compras
        </h1>
        <p class="text-sm text-slate-400">Ranking de clientes por numero de reservas y monto total</p>
    </div>

    <form method="get" class="flex gap-2 mb-6 flex-wrap">
        <input type="number" name="top" value="@ViewBag.Top" min="1" max="50"
               class="px-3 py-2 rounded-xl border border-slate-200 text-sm text-slate-700 focus:outline-none focus:border-primary-400 w-24" />
        <input type="date" name="fechaDesde" value="@ViewBag.FechaDesde"
               class="px-3 py-2 rounded-xl border border-slate-200 text-sm text-slate-700 focus:outline-none focus:border-primary-400" />
        <input type="date" name="fechaHasta" value="@ViewBag.FechaHasta"
               class="px-3 py-2 rounded-xl border border-slate-200 text-sm text-slate-700 focus:outline-none focus:border-primary-400" />
        <button type="submit" class="px-4 py-2 rounded-xl bg-primary-500 text-white text-sm font-medium hover:bg-primary-600 transition">
            <i class="bi bi-search"></i> Filtrar
        </button>
        <a asp-action="ClientesTopCompras" class="px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-500 hover:bg-slate-50 transition">
            <i class="bi bi-x-circle"></i> Limpiar
        </a>
    </form>

    <div class="bg-white rounded-2xl border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-slate-100">
                        <th class="text-left px-5 py-3 font-medium text-slate-500">#</th>
                        <th class="text-left px-5 py-3 font-medium text-slate-500">Cliente</th>
                        <th class="text-left px-5 py-3 font-medium text-slate-500">Reservas</th>
                        <th class="text-left px-5 py-3 font-medium text-slate-500">Monto Total</th>
                        <th class="text-left px-5 py-3 font-medium text-slate-500">Promedio/Reserva</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (dynamic item in (IEnumerable<dynamic>)ViewData["Resultados"] ?? Enumerable.Empty<dynamic>())
                    {
                        var badgeColor = item.Posicion switch
                        {
                            1 => "bg-amber-100 text-amber-700",
                            2 => "bg-slate-200 text-slate-600",
                            3 => "bg-orange-100 text-orange-700",
                            _ => "bg-slate-50 text-slate-500"
                        };
                        <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition">
                            <td class="px-5 py-3">
                                <span class="inline-flex items-center justify-center w-7 h-7 rounded-full @badgeColor text-xs font-bold">@item.Posicion</span>
                            </td>
                            <td class="px-5 py-3 font-medium text-slate-700">@item.Nombre</td>
                            <td class="px-5 py-3 font-semibold text-primary-600">@item.TotalReservas</td>
                            <td class="px-5 py-3 font-semibold text-slate-700">$@(((decimal)item.MontoTotal).ToString("N2"))</td>
                            <td class="px-5 py-3 text-slate-500">$@(((decimal)item.PromedioPorReserva).ToString("N2"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
