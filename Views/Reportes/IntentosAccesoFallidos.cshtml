@{
    ViewData["Title"] = "Intentos de Acceso Fallidos";
}

<div class="fade-in">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
            <i class="bi bi-shield-lock text-rose-500"></i> Intentos de Acceso Fallidos
        </h1>
        <p class="text-sm text-slate-400">Registro de accesos denegados y cuentas bloqueadas</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <h3 class="text-2xl font-bold text-rose-600">@ViewBag.TotalRegistros</h3>
            <p class="text-xs text-slate-500">Total Intentos Fallidos</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-100 p-4">
            <h4 class="text-sm font-semibold text-slate-700 mb-2">Por Tipo</h4>
            <div class="flex flex-wrap gap-2">
                @foreach (var item in (IEnumerable<dynamic>)ViewBag.ResumenPorAccion ?? Enumerable.Empty<dynamic>())
                {
                    var color = ((string)item.Accion) == "Cuenta bloqueada" ? "bg-rose-50 text-rose-600 border-rose-200" : "bg-amber-50 text-amber-600 border-amber-200";
                    <span class="px-3 py-1 rounded-lg border @color text-xs font-medium">
                        @item.Accion: @item.Cantidad
                    </span>
                }
            </div>
        </div>
    </div>

    <form method="get" class="flex gap-2 mb-6 flex-wrap">
        <input type="date" name="fechaDesde" value="@ViewBag.FechaDesde"
               class="px-3 py-2 rounded-xl border border-slate-200 text-sm text-slate-700 focus:outline-none focus:border-primary-400" />
        <input type="date" name="fechaHasta" value="@ViewBag.FechaHasta"
               class="px-3 py-2 rounded-xl border border-slate-200 text-sm text-slate-700 focus:outline-none focus:border-primary-400" />
        <button type="submit" class="px-4 py-2 rounded-xl bg-primary-500 text-white text-sm font-medium hover:bg-primary-600 transition">
            <i class="bi bi-search"></i> Filtrar
        </button>
        <a asp-action="IntentosAccesoFallidos" class="px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-500 hover:bg-slate-50 transition">
            <i class="bi bi-x-circle"></i> Limpiar
        </a>
    </form>

    <div class="bg-white rounded-2xl border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-slate-100">
                        <th class="text-left px-5 py-3 font-medium text-slate-500">Fecha/Hora</th>
                        <th class="text-left px-5 py-3 font-medium text-slate-500">Email</th>
                        <th class="text-left px-5 py-3 font-medium text-slate-500">Accion</th>
                        <th class="text-left px-5 py-3 font-medium text-slate-500">Metodo</th>
                        <th class="text-left px-5 py-3 font-medium text-slate-500">Ruta</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!((IEnumerable<dynamic>)ViewData["Registros"] ?? Enumerable.Empty<dynamic>()).Any())
                    {
                        <tr>
                            <td colspan="5" class="px-4 py-8 text-center text-slate-400">
                                <i class="bi bi-check-circle text-3xl mb-2 block text-emerald-400"></i>
                                No hay intentos fallidos en el rango seleccionado.
                            </td>
                        </tr>
                    }
                    @foreach (dynamic item in (IEnumerable<dynamic>)ViewData["Registros"] ?? Enumerable.Empty<dynamic>())
                    {
                        var accionColor = ((string)item.Accion) == "Cuenta bloqueada"
                            ? "bg-rose-100 text-rose-700"
                            : "bg-amber-100 text-amber-700";
                        <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition">
                            <td class="px-5 py-3 text-xs text-slate-500 whitespace-nowrap">@(((DateTime)item.Fecha).ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss"))</td>
                            <td class="px-5 py-3 text-slate-700">@(item.Email ?? "—")</td>
                            <td class="px-5 py-3">
                                <span class="inline-flex px-2 py-0.5 rounded-md @accionColor text-xs font-medium">@item.Accion</span>
                            </td>
                            <td class="px-5 py-3 text-xs text-slate-500">@(item.Metodo ?? "—")</td>
                            <td class="px-5 py-3 text-xs text-slate-500 max-w-[200px] truncate" title="@item.Ruta">@(item.Ruta ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if ((int)ViewBag.TotalPages > 1)
    {
        <div class="flex justify-center items-center gap-2 mt-6">
            @if ((int)ViewBag.PageNumber > 1)
            {
                <a asp-action="IntentosAccesoFallidos" asp-route-pageNumber="@((int)ViewBag.PageNumber - 1)" asp-route-fechaDesde="@ViewBag.FechaDesde" asp-route-fechaHasta="@ViewBag.FechaHasta"
                   class="px-3 py-2 rounded-xl border border-slate-200 text-sm text-slate-500 hover:bg-slate-50 transition">
                    <i class="bi bi-chevron-left"></i>
                </a>
            }
            <span class="px-3 py-2 text-sm text-slate-500">
                Pagina <span class="font-semibold text-slate-700">@ViewBag.PageNumber</span> de @ViewBag.TotalPages
            </span>
            @if ((int)ViewBag.PageNumber < (int)ViewBag.TotalPages)
            {
                <a asp-action="IntentosAccesoFallidos" asp-route-pageNumber="@((int)ViewBag.PageNumber + 1)" asp-route-fechaDesde="@ViewBag.FechaDesde" asp-route-fechaHasta="@ViewBag.FechaHasta"
                   class="px-3 py-2 rounded-xl border border-slate-200 text-sm text-slate-500 hover:bg-slate-50 transition">
                    <i class="bi bi-chevron-right"></i>
                </a>
            }
        </div>
    }
</div>
