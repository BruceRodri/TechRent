@model IEnumerable<TechRent.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<div class="fade-in">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                <i class="bi bi-calendar-check text-primary-500"></i> Reservas
            </h1>
            <p class="text-sm text-slate-400">Gestion de reservas de equipos</p>
        </div>
        <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary-500 text-white text-sm font-medium hover:bg-primary-600 transition shadow-sm">
            <i class="bi bi-plus-circle"></i> Nueva Reserva
        </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-calendar-check text-primary-400 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">@ViewBag.TotalRegistros</h3>
            <p class="text-xs text-slate-500">Registradas</p>
        </div>
    </div>

    <form method="get" class="flex gap-2 mb-6">
        <input type="text" name="searchString" value="@ViewBag.SearchString" class="flex-1 px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" placeholder="Buscar por cliente..." />
        <button type="submit" class="px-4 py-2 rounded-xl bg-primary-500 text-white text-sm font-medium hover:bg-primary-600 transition"><i class="bi bi-search"></i> Buscar</button>
        <a asp-action="Index" class="px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-500 hover:bg-slate-50 transition"><i class="bi bi-x-circle"></i> Limpiar</a>
    </form>

    <div class="bg-white rounded-2xl border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-slate-100">
                        <th class="text-left px-4 py-3 font-medium text-slate-500">Cliente</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-500">Equipos</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-500">Inicio</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-500">Fin</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-500">Monto</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-500">Estado</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-500">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition">
                            <td class="px-4 py-3 font-medium text-slate-700">@item.Cliente?.NombreCompleto</td>
                            <td class="px-4 py-3">
                                @if (item.DetalleReservas != null && item.DetalleReservas.Any())
                                {
                                    @foreach (var d in item.DetalleReservas.Take(2))
                                    {
                                        <span class="inline-flex px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 text-xs font-medium mr-1">@d.Equipo?.Nombre x@(d.Cantidad)</span>
                                    }
                                    @if (item.DetalleReservas.Count > 2)
                                    {
                                        <span class="inline-flex px-2 py-0.5 rounded-md bg-slate-200 text-slate-600 text-xs font-medium">+@(item.DetalleReservas.Count - 2)</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-slate-400 text-xs">—</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-slate-500">@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td class="px-4 py-3 text-slate-500">@item.FechaFin.ToString("dd/MM/yyyy")</td>
                            <td class="px-4 py-3 font-semibold text-emerald-600">$@item.MontoTotal.ToString("0.00")</td>
                            <td class="px-4 py-3">
                                @if (item.EstadoReserva?.Nombre == "Activa")
                                {
                                    <span class="inline-flex px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-600 text-xs font-medium">Activa</span>
                                }
                                else if (item.EstadoReserva?.Nombre == "Pendiente")
                                {
                                    <span class="inline-flex px-2 py-0.5 rounded-md bg-amber-50 text-amber-600 text-xs font-medium">Pendiente</span>
                                }
                                else if (item.EstadoReserva?.Nombre == "Completada")
                                {
                                    <span class="inline-flex px-2 py-0.5 rounded-md bg-primary-50 text-primary-600 text-xs font-medium">Completada</span>
                                }
                                else
                                {
                                    <span class="inline-flex px-2 py-0.5 rounded-md bg-rose-50 text-rose-600 text-xs font-medium">@item.EstadoReserva?.Nombre</span>
                                }
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-1">
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="p-1.5 rounded-lg text-primary-500 hover:bg-primary-50 transition"><i class="bi bi-pencil text-sm"></i></a>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.Id" class="p-1.5 rounded-lg text-slate-400 hover:bg-slate-100 transition"><i class="bi bi-eye text-sm"></i></a>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="p-1.5 rounded-lg text-rose-400 hover:bg-rose-50 transition"><i class="bi bi-trash text-sm"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @await Html.PartialAsync("_Pagination")
</div>
