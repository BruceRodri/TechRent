@model TechRent.Models.Reserva

@{
    ViewData["Title"] = "Detalle de Reserva";
}

<div class="fade-in">
    <div class="max-w-4xl mx-auto">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-bold text-slate-800">Detalle de Reserva</h1>
                <p class="text-slate-500 text-sm mt-1">Información completa de la reserva</p>
            </div>
            <div class="flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="px-5 py-2.5 rounded-xl bg-primary-500 text-white text-sm font-semibold hover:bg-primary-600 transition shadow-sm">
                    Editar
                </a>
                <a asp-action="Index" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-500 hover:border-slate-300 hover:text-slate-700 transition">
                    Volver
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Información General -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
                <h2 class="text-lg font-bold text-slate-800 mb-4">Información General</h2>
                <div class="space-y-3">
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500">Cliente</span>
                        <span class="text-sm text-slate-800">@Model.Cliente?.NombreCompleto</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500">Estado</span>
                        @if (Model.EstadoReserva?.Nombre == "Activa")
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700">Activa</span>
                        }
                        else if (Model.EstadoReserva?.Nombre == "Pendiente")
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700">Pendiente</span>
                        }
                        else if (Model.EstadoReserva?.Nombre == "Completada")
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-sky-100 text-sky-700">Completada</span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-100 text-rose-700">@Model.EstadoReserva?.Nombre</span>
                        }
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500">Fecha Inicio</span>
                        <span class="text-sm text-slate-800">@Model.FechaInicio.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500">Fecha Fin</span>
                        <span class="text-sm text-slate-800">@Model.FechaFin.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500">Monto Total</span>
                        <span class="text-sm font-bold text-emerald-600">$@Model.MontoTotal.ToString("0.00")</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500">Observaciones</span>
                        <span class="text-sm text-slate-800 text-right max-w-xs">@(Model.Observaciones ?? "—")</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500">Fecha Creación</span>
                        <span class="text-sm text-slate-800">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>
            </div>

            <!-- Equipos Reservados -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
                <h2 class="text-lg font-bold text-slate-800 mb-4">Equipos Reservados</h2>
                @if (Model.DetalleReservas != null && Model.DetalleReservas.Any())
                {
                    <div class="space-y-2">
                        @foreach (var det in Model.DetalleReservas)
                        {
                            <div class="flex items-center justify-between py-2 px-3 bg-slate-50 rounded-xl">
                                <div>
                                    <span class="text-sm font-medium text-slate-700">@det.Equipo?.Nombre</span>
                                    <span class="text-xs text-slate-500 ml-2">x @det.Cantidad</span>
                                </div>
                                <div class="text-right">
                                    <span class="text-sm font-semibold text-slate-800">$@det.Subtotal.ToString("0.00")</span>
                                    <span class="text-xs text-slate-500 block">@det.CantidadDias días @("$" + det.PrecioUnitarioPorDia.ToString("0.00"))/día</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-slate-400 text-sm text-center py-4">Sin equipos registrados</p>
                }

                <h2 class="text-lg font-bold text-slate-800 mt-6 mb-4">Pagos</h2>
                @if (Model.Pagos != null && Model.Pagos.Any())
                {
                    <div class="space-y-2">
                        @foreach (var p in Model.Pagos)
                        {
                            <div class="flex items-center justify-between py-2 px-3 bg-slate-50 rounded-xl">
                                <div>
                                    <span class="text-sm font-medium text-slate-700">@p.MetodoPago</span>
                                    <span class="text-xs text-slate-500 block">@p.FechaPago.ToString("dd/MM/yyyy")</span>
                                </div>
                                <span class="text-sm font-semibold text-emerald-600">$@p.Monto.ToString("0.00")</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-slate-400 text-sm text-center py-4">Sin pagos registrados</p>
                }
            </div>
        </div>
    </div>
</div>
