@model IEnumerable<TechRent.Models.Marca>

@{
    ViewData["Title"] = "Marcas";
}

<div class="fade-in">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                <i class="bi bi-building text-primary-500"></i> Marcas
            </h1>
            <p class="text-sm text-slate-400">Gestion de marcas de equipos tecnologicos</p>
        </div>
        <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary-500 text-white text-sm font-medium hover:bg-primary-600 transition shadow-sm">
            <i class="bi bi-plus-circle"></i> Nueva Marca
        </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-building text-primary-400 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">@ViewBag.TotalRegistros</h3>
            <p class="text-xs text-slate-500">Registradas</p>
        </div>
    </div>

    <form method="get" class="flex gap-2 mb-6">
        <input type="text" name="searchString" value="@ViewBag.SearchString" class="flex-1 px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" placeholder="Buscar por nombre o pais..." />
        <button type="submit" class="px-4 py-2 rounded-xl bg-primary-500 text-white text-sm font-medium hover:bg-primary-600 transition"><i class="bi bi-search"></i> Buscar</button>
        <a asp-action="Index" class="px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-500 hover:bg-slate-50 transition"><i class="bi bi-x-circle"></i> Limpiar</a>
    </form>

    <div class="bg-white rounded-2xl border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-slate-100">
                        <th class="text-left px-4 py-3 font-medium text-slate-500">Nombre</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-500">Pais de Origen</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-500">Fecha Creacion</th>
                        <th class="text-left px-4 py-3 font-medium text-slate-500">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition">
                            <td class="px-4 py-3 font-medium text-slate-700">@item.Nombre</td>
                            <td class="px-4 py-3 text-slate-500">@(item.PaisOrigen ?? "—")</td>
                            <td class="px-4 py-3 text-slate-500">@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="p-1.5 rounded-lg text-primary-500 hover:bg-primary-50 transition"><i class="bi bi-pencil text-sm"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="p-1.5 rounded-lg text-slate-400 hover:bg-slate-100 transition"><i class="bi bi-eye text-sm"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="p-1.5 rounded-lg text-rose-400 hover:bg-rose-50 transition"><i class="bi bi-trash text-sm"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @await Html.PartialAsync("_Pagination")
</div>
