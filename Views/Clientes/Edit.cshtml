@model TechRent.Models.Cliente

@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="fade-in">
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <div class="px-6 py-4 bg-gradient-to-r from-primary-500 to-primary-600">
                <h1 class="text-xl font-bold text-white">Editar Cliente</h1>
                <p class="text-primary-100 text-sm mt-1">Modifique los datos del cliente</p>
            </div>
            <div class="p-6">
                <form asp-action="Edit">
                    <div asp-validation-summary="All" class="bg-rose-50 border border-rose-200 text-rose-600 text-sm rounded-xl px-4 py-3 mb-4"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-4">
                        <label asp-for="NombreCompleto" class="block text-sm font-medium text-slate-600 mb-1.5">Nombre Completo</label>
                        <input asp-for="NombreCompleto" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" />
                        <span asp-validation-for="NombreCompleto" class="text-rose-500 text-xs mt-1 block"></span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label asp-for="Email" class="block text-sm font-medium text-slate-600 mb-1.5">Email</label>
                            <input asp-for="Email" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" type="email" />
                            <span asp-validation-for="Email" class="text-rose-500 text-xs mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="Telefono" class="block text-sm font-medium text-slate-600 mb-1.5">Teléfono</label>
                            <input asp-for="Telefono" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" />
                            <span asp-validation-for="Telefono" class="text-rose-500 text-xs mt-1 block"></span>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label asp-for="Direccion" class="block text-sm font-medium text-slate-600 mb-1.5">Dirección</label>
                            <input asp-for="Direccion" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" />
                            <span asp-validation-for="Direccion" class="text-rose-500 text-xs mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="DocumentoIdentidad" class="block text-sm font-medium text-slate-600 mb-1.5">Documento de Identidad</label>
                            <input asp-for="DocumentoIdentidad" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" />
                            <span asp-validation-for="DocumentoIdentidad" class="text-rose-500 text-xs mt-1 block"></span>
                        </div>
                    </div>

                    <div class="mb-6">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input asp-for="Activo" class="w-4 h-4 rounded border-slate-300 text-primary-500 focus:ring-primary-400" />
                            <span class="text-sm font-medium text-slate-600">@Html.DisplayNameFor(model => model.Activo)</span>
                        </label>
                    </div>

                    <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                        <a asp-action="Index" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-500 hover:border-slate-300 hover:text-slate-700 transition">
                            Cancelar
                        </a>
                        <button type="submit" class="px-5 py-2.5 rounded-xl bg-primary-500 text-white text-sm font-semibold hover:bg-primary-600 transition shadow-sm">
                            Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
