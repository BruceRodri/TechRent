@model IEnumerable<TechRent.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="fade-in">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                <i class="bi bi-people-fill text-primary-500"></i> Clientes
            </h1>
            <p class="text-sm text-slate-400">Gestion de clientes que alquilan equipos</p>
        </div>
        <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary-500 text-white text-sm font-medium hover:bg-primary-600 transition shadow-sm">
            <i class="bi bi-person-plus-fill"></i> Nuevo Cliente
        </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-people-fill text-primary-400 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">@ViewBag.TotalRegistros</h3>
            <p class="text-xs text-slate-500">Registrados</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-envelope-fill text-emerald-400 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">@ViewBag.ClientesConEmail</h3>
            <p class="text-xs text-slate-500">Con Email</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-slate-100 text-center">
            <i class="bi bi-telephone-fill text-rose-400 text-xl mb-2 block"></i>
            <h3 class="text-2xl font-bold text-slate-800">@ViewBag.ClientesConTelefono</h3>
            <p class="text-xs text-slate-500">Con Telefono</p>
        </div>
    </div>

    <form method="get" class="flex gap-2 mb-6">
        <input type="text" name="searchString" value="@ViewBag.SearchString" class="flex-1 px-4 py-2 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" placeholder="Buscar por nombre, email o telefono..." />
        <button type="submit" class="px-4 py-2 rounded-xl bg-primary-500 text-white text-sm font-medium hover:bg-primary-600 transition"><i class="bi bi-search"></i> Buscar</button>
        <a asp-action="Index" class="px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-500 hover:bg-slate-50 transition"><i class="bi bi-x-circle"></i> Limpiar</a>
    </form>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        @foreach (var item in Model)
        {
            <div class="bg-white rounded-2xl border border-slate-100 p-5 hover:border-primary-200 transition flex flex-col">
                <div class="flex items-start justify-between mb-3">
                    <div class="flex items-center gap-2">
                        <div class="w-9 h-9 rounded-xl bg-primary-100 flex items-center justify-center">
                            <i class="bi bi-person-circle text-primary-500"></i>
                        </div>
                        <div>
                            <h3 class="text-sm font-semibold text-slate-800">@item.NombreCompleto</h3>
                            <p class="text-xs text-slate-400">ID: @item.DocumentoIdentidad</p>
                        </div>
                    </div>
                    <span class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-600 text-xs font-medium">Activo</span>
                </div>
                <div class="space-y-1.5 mb-4 flex-1">
                    <div class="flex items-center gap-2 text-xs text-slate-500"><i class="bi bi-envelope text-primary-400"></i> @item.Email</div>
                    <div class="flex items-center gap-2 text-xs text-slate-500"><i class="bi bi-telephone text-emerald-400"></i> @item.Telefono</div>
                    <div class="flex items-center gap-2 text-xs text-slate-500"><i class="bi bi-geo-alt text-rose-400"></i> @(item.Direccion ?? "Sin direccion")</div>
                </div>
                <div class="flex items-center justify-between pt-3 border-t border-slate-100">
                    <span class="text-[10px] text-slate-400"><i class="bi bi-calendar"></i> @item.FechaCreacion.ToString("dd/MM/yyyy")</span>
                    <div class="flex items-center gap-1">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="p-1.5 rounded-lg text-primary-500 hover:bg-primary-50 transition"><i class="bi bi-pencil text-sm"></i></a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="p-1.5 rounded-lg text-slate-400 hover:bg-slate-100 transition"><i class="bi bi-eye text-sm"></i></a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="p-1.5 rounded-lg text-rose-400 hover:bg-rose-50 transition"><i class="bi bi-trash text-sm"></i></a>
                    </div>
                </div>
            </div>
        }
    </div>
    @await Html.PartialAsync("_Pagination")
</div>
