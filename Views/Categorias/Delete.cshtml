@model TechRent.Models.Categoria

@{
    ViewData["Title"] = "Eliminar Categoría";
}

<div class="fade-in">
    <div class="max-w-lg mx-auto">
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <div class="px-6 py-4 bg-gradient-to-r from-rose-500 to-rose-600">
                <h1 class="text-xl font-bold text-white">Eliminar Categoría</h1>
                <p class="text-rose-100 text-sm mt-1">¿Está seguro que desea eliminar esta categoría?</p>
            </div>
            <div class="p-6">
                <div class="space-y-3 mb-6">
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500">Nombre</span>
                        <span class="text-sm text-slate-800">@Model.Nombre</span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-500">Descripción</span>
                        <span class="text-sm text-slate-800 text-right max-w-xs">@(Model.Descripcion ?? "Sin descripción")</span>
                    </div>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                        <a asp-action="Index" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-500 hover:border-slate-300 hover:text-slate-700 transition">
                            Cancelar
                        </a>
                        <button type="submit" class="px-5 py-2.5 rounded-xl bg-rose-500 text-white text-sm font-semibold hover:bg-rose-600 transition shadow-sm">
                            Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
