@model TechRent.Models.Categoria

@{
    ViewData["Title"] = "Editar Categoría";
}

<div class="fade-in">
    <div class="max-w-lg mx-auto">
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <div class="px-6 py-4 bg-gradient-to-r from-primary-500 to-primary-600">
                <h1 class="text-xl font-bold text-white">Editar Categoría</h1>
                <p class="text-primary-100 text-sm mt-1">Modifique los datos de la categoría</p>
            </div>
            <div class="p-6">
                <form asp-action="Edit">
                    <div asp-validation-summary="All" class="bg-rose-50 border border-rose-200 text-rose-600 text-sm rounded-xl px-4 py-3 mb-4"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-4">
                        <label asp-for="Nombre" class="block text-sm font-medium text-slate-600 mb-1.5">Nombre</label>
                        <input asp-for="Nombre" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" />
                        <span asp-validation-for="Nombre" class="text-rose-500 text-xs mt-1 block"></span>
                    </div>

                    <div class="mb-6">
                        <label asp-for="Descripcion" class="block text-sm font-medium text-slate-600 mb-1.5">Descripción</label>
                        <textarea asp-for="Descripcion" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" rows="3"></textarea>
                        <span asp-validation-for="Descripcion" class="text-rose-500 text-xs mt-1 block"></span>
                    </div>

                    <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                        <a asp-action="Index" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-500 hover:border-slate-300 hover:text-slate-700 transition">
                            Cancelar
                        </a>
                        <button type="submit" class="px-5 py-2.5 rounded-xl bg-primary-500 text-white text-sm font-semibold hover:bg-primary-600 transition shadow-sm">
                            Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
