@model string

@if (!String.IsNullOrEmpty(Model))
{
    var isError = Model.StartsWith("Error");
    <div class="@(isError ? "bg-rose-50 border-rose-200 text-rose-600" : "bg-emerald-50 border-emerald-200 text-emerald-600") border rounded-xl px-4 py-3 mb-4 text-sm flex items-center gap-2">
        <i class="bi @(isError ? "bi-exclamation-circle" : "bi-check-circle")"></i>
        @Model
    </div>
}
