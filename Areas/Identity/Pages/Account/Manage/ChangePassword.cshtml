@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar contrasena";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="bg-white rounded-2xl border border-slate-100 p-6">
    <h3 class="text-lg font-bold text-slate-800 mb-1">Cambiar contrasena</h3>
    <p class="text-sm text-slate-400 mb-6">Actualiza la contrasena de tu cuenta</p>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="change-password-form" method="post" class="max-w-md">
        <div asp-validation-summary="ModelOnly" class="bg-rose-50 border border-rose-200 text-rose-600 text-sm rounded-xl px-4 py-3 mb-4" role="alert"></div>

        <div class="mb-4">
            <label asp-for="Input.OldPassword" class="block text-sm font-medium text-slate-600 mb-1.5">Contrasena actual</label>
            <input asp-for="Input.OldPassword" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" autocomplete="current-password" placeholder="********" />
            <span asp-validation-for="Input.OldPassword" class="text-rose-500 text-xs mt-1 block"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Input.NewPassword" class="block text-sm font-medium text-slate-600 mb-1.5">Nueva contrasena</label>
            <input asp-for="Input.NewPassword" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" autocomplete="new-password" placeholder="********" />
            <span asp-validation-for="Input.NewPassword" class="text-rose-500 text-xs mt-1 block"></span>
        </div>

        <div class="mb-6">
            <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-slate-600 mb-1.5">Confirmar contrasena</label>
            <input asp-for="Input.ConfirmPassword" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" autocomplete="new-password" placeholder="********" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-rose-500 text-xs mt-1 block"></span>
        </div>

        <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary-500 text-white text-sm font-semibold hover:bg-primary-600 transition shadow-sm">
            Actualizar contrasena
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
