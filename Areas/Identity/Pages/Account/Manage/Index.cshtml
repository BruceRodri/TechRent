@page
@model IndexModel
@{
    ViewData["Title"] = "Perfil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="bg-white rounded-2xl border border-slate-100 p-6">
    <h3 class="text-lg font-bold text-slate-800 mb-1">Mi perfil</h3>
    <p class="text-sm text-slate-400 mb-6">Administra la informacion de tu cuenta</p>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="profile-form" method="post" class="max-w-md">
        <div asp-validation-summary="ModelOnly" class="bg-rose-50 border border-rose-200 text-rose-600 text-sm rounded-xl px-4 py-3 mb-4" role="alert"></div>

        <div class="mb-4">
            <label asp-for="Username" class="block text-sm font-medium text-slate-600 mb-1.5">Usuario</label>
            <input asp-for="Username" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-400 bg-slate-50 cursor-not-allowed" disabled />
        </div>

        <div class="mb-6">
            <label asp-for="Input.PhoneNumber" class="block text-sm font-medium text-slate-600 mb-1.5">Telefono</label>
            <input asp-for="Input.PhoneNumber" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" placeholder="0991234567" />
            <span asp-validation-for="Input.PhoneNumber" class="text-rose-500 text-xs mt-1 block"></span>
        </div>

        <button id="update-profile-button" type="submit" class="px-6 py-2.5 rounded-xl bg-primary-500 text-white text-sm font-semibold hover:bg-primary-600 transition shadow-sm">
            Guardar cambios
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
