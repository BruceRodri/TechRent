@page
@model EmailModel
@{
    ViewData["Title"] = "Correo electronico";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="bg-white rounded-2xl border border-slate-100 p-6">
    <h3 class="text-lg font-bold text-slate-800 mb-1">Correo electronico</h3>
    <p class="text-sm text-slate-400 mb-6">Gestiona tu direccion de correo electronico</p>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="email-form" method="post" class="max-w-md">
        <div asp-validation-summary="All" class="bg-rose-50 border border-rose-200 text-rose-600 text-sm rounded-xl px-4 py-3 mb-4" role="alert"></div>

        @if (Model.IsEmailConfirmed)
        {
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-600 mb-1.5">Correo actual</label>
                <div class="flex items-center gap-2">
                    <input asp-for="Email" class="flex-1 px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-400 bg-slate-50" disabled />
                    <span class="text-emerald-500"><i class="bi bi-check-circle-fill text-lg"></i></span>
                </div>
            </div>
        }
        else
        {
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-600 mb-1.5">Correo actual</label>
                <input asp-for="Email" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-400 bg-slate-50" disabled />
                <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="mt-2 text-sm text-primary-500 hover:text-primary-600 font-medium transition">
                    Enviar correo de verificacion
                </button>
            </div>
        }

        <div class="mb-6">
            <label asp-for="Input.NewEmail" class="block text-sm font-medium text-slate-600 mb-1.5">Nuevo correo electronico</label>
            <input asp-for="Input.NewEmail" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" autocomplete="email" placeholder="nuevo@email.com" />
            <span asp-validation-for="Input.NewEmail" class="text-rose-500 text-xs mt-1 block"></span>
        </div>

        <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="px-6 py-2.5 rounded-xl bg-primary-500 text-white text-sm font-semibold hover:bg-primary-600 transition shadow-sm">
            Cambiar correo
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
