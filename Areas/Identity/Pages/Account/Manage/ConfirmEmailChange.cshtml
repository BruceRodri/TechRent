@page
@model ConfirmEmailChangeModel
@{
    ViewData["Title"] = "Confirmar cambio de correo";
}

<div class="min-h-[60vh] flex items-center justify-center">
    <div class="bg-white rounded-2xl border border-slate-100 p-8 max-w-md w-full text-center">
        <div class="w-14 h-14 rounded-2xl bg-primary-100 flex items-center justify-center mx-auto mb-5">
            <i class="bi bi-envelope-check text-2xl text-primary-500"></i>
        </div>
        <h2 class="text-xl font-bold text-slate-800 mb-3">@ViewData["Title"]</h2>
        <p class="text-sm text-slate-500 mb-6">Tu nuevo correo ha sido confirmado exitosamente.</p>
        <a asp-page="./Index"
           class="inline-block px-5 py-2.5 rounded-xl bg-primary-500 text-white text-sm font-semibold hover:bg-primary-600 transition shadow-sm">
            Volver al perfil
        </a>
    </div>
</div>
