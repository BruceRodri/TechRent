@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Autenticacion de dos factores";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="bg-white rounded-2xl border border-slate-100 p-6">
    <h3 class="text-lg font-bold text-slate-800 mb-1">@ViewData["Title"]</h3>
    <p class="text-sm text-slate-400 mb-6">Gestiona la seguridad de tu cuenta con autenticacion de dos pasos</p>

    <partial name="_StatusMessage" for="StatusMessage" />

    @{
        var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
        @if (consentFeature?.CanTrack ?? true)
        {
            @if (Model.Is2faEnabled)
            {
                @if (Model.RecoveryCodesLeft == 0)
                {
                    <div class="bg-rose-50 border border-rose-200 text-rose-600 rounded-xl px-4 py-3 mb-4 text-sm">
                        <strong>No te quedan codigos de recuperacion.</strong>
                        <p>Debes <a asp-page="./GenerateRecoveryCodes" class="font-medium underline">generar un nuevo conjunto</a> antes de poder iniciar sesion con un codigo de recuperacion.</p>
                    </div>
                }
                else if (Model.RecoveryCodesLeft == 1)
                {
                    <div class="bg-rose-50 border border-rose-200 text-rose-600 rounded-xl px-4 py-3 mb-4 text-sm">
                        <strong>Te queda 1 codigo de recuperacion.</strong>
                        <p>Puedes <a asp-page="./GenerateRecoveryCodes" class="font-medium underline">generar un nuevo conjunto</a>.</p>
                    </div>
                }
                else if (Model.RecoveryCodesLeft <= 3)
                {
                    <div class="bg-amber-50 border border-amber-200 text-amber-600 rounded-xl px-4 py-3 mb-4 text-sm">
                        <strong>Te quedan @Model.RecoveryCodesLeft codigos de recuperacion.</strong>
                        <p>Deberias <a asp-page="./GenerateRecoveryCodes" class="font-medium underline">generar un nuevo conjunto</a>.</p>
                    </div>
                }

                <div class="flex flex-wrap gap-3 mb-6">
                    @if (Model.IsMachineRemembered)
                    {
                        <form method="post" class="inline">
                            <button type="submit" class="px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-600 hover:bg-slate-50 transition">
                                <i class="bi bi-browser-chrome mr-1"></i> Olvidar este navegador
                            </button>
                        </form>
                    }
                    <a asp-page="./Disable2fa" class="px-4 py-2 rounded-xl border border-rose-200 text-sm font-medium text-rose-600 hover:bg-rose-50 transition">
                        <i class="bi bi-shield-x mr-1"></i> Desactivar 2FA
                    </a>
                    <a asp-page="./GenerateRecoveryCodes" class="px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-600 hover:bg-slate-50 transition">
                        <i class="bi bi-key mr-1"></i> Regenerar codigos
                    </a>
                </div>
            }

            <div class="border-t border-slate-100 pt-6">
                <h4 class="text-sm font-semibold text-slate-700 mb-3">Aplicacion de autenticacion</h4>
                @if (!Model.HasAuthenticator)
                {
                    <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="inline-block px-5 py-2.5 rounded-xl bg-primary-500 text-white text-sm font-semibold hover:bg-primary-600 transition shadow-sm">
                        <i class="bi bi-phone mr-1"></i> Agregar aplicacion de autenticacion
                    </a>
                }
                else
                {
                    <div class="flex flex-wrap gap-3">
                        <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="px-5 py-2.5 rounded-xl bg-primary-500 text-white text-sm font-semibold hover:bg-primary-600 transition shadow-sm">
                            <i class="bi bi-phone mr-1"></i> Configurar aplicacion
                        </a>
                        <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="px-4 py-2 rounded-xl border border-slate-200 text-sm font-medium text-slate-600 hover:bg-slate-50 transition">
                            <i class="bi bi-arrow-counterclockwise mr-1"></i> Restablecer clave
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-rose-50 border border-rose-200 text-rose-600 rounded-xl px-4 py-3 mb-4 text-sm">
                <strong>Debes aceptar la politica de privacidad y cookies.</strong>
            </div>
        }
    }
</div>
