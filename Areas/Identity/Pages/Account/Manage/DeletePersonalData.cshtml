@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Eliminar datos personales";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="bg-white rounded-2xl border border-slate-100 p-6">
    <h3 class="text-lg font-bold text-slate-800 mb-1">@ViewData["Title"]</h3>
    <p class="text-sm text-slate-400 mb-6">Elimina permanentemente tu cuenta y todos sus datos</p>

    <div class="bg-rose-50 border border-rose-200 text-rose-700 text-sm rounded-xl px-4 py-3 mb-6">
        <strong class="block mb-1">No se pueden deshacer esta accion.</strong>
        Tu cuenta sera eliminada permanentemente. Esta accion es irreversible.
    </div>

    <form id="delete-user" method="post" class="max-w-md">
        <div asp-validation-summary="ModelOnly" class="bg-rose-50 border border-rose-200 text-rose-600 text-sm rounded-xl px-4 py-3 mb-4" role="alert"></div>

        @if (Model.RequirePassword)
        {
            <div class="mb-4">
                <label asp-for="Input.Password" class="block text-sm font-medium text-slate-600 mb-1.5">Contrasena</label>
                <input asp-for="Input.Password" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" autocomplete="current-password" placeholder="********" />
                <span asp-validation-for="Input.Password" class="text-rose-500 text-xs mt-1 block"></span>
            </div>
        }

        <button type="submit"
                class="px-5 py-2.5 rounded-xl bg-rose-500 text-white text-sm font-semibold hover:bg-rose-600 transition shadow-sm">
            <i class="bi bi-trash mr-1"></i> Eliminar datos y cuenta
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
