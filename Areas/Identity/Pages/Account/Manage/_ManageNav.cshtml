@inject SignInManager<IdentityUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<nav class="space-y-1">
    <a asp-page="./Index"
       class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium transition
              @(ManageNavPages.IndexNavClass(ViewContext) == "active" ? "bg-primary-50 text-primary-600" : "text-slate-500 hover:bg-slate-50 hover:text-slate-700")">
        <i class="bi bi-person text-sm"></i> Perfil
    </a>
    <a asp-page="./Email"
       class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium transition
              @(ManageNavPages.EmailNavClass(ViewContext) == "active" ? "bg-primary-50 text-primary-600" : "text-slate-500 hover:bg-slate-50 hover:text-slate-700")">
        <i class="bi bi-envelope text-sm"></i> Correo electronico
    </a>
    <a asp-page="./ChangePassword"
       class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium transition
              @(ManageNavPages.ChangePasswordNavClass(ViewContext) == "active" ? "bg-primary-50 text-primary-600" : "text-slate-500 hover:bg-slate-50 hover:text-slate-700")">
        <i class="bi bi-key text-sm"></i> Contrasena
    </a>
    @if (hasExternalLogins)
    {
        <a asp-page="./ExternalLogins"
           class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium transition
                  @(ManageNavPages.ExternalLoginsNavClass(ViewContext) == "active" ? "bg-primary-50 text-primary-600" : "text-slate-500 hover:bg-slate-50 hover:text-slate-700")">
            <i class="bi bi-box-arrow-up-right text-sm"></i> Inicios de sesion externos
        </a>
    }
    <a asp-page="./TwoFactorAuthentication"
       class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium transition
              @(ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext) == "active" ? "bg-primary-50 text-primary-600" : "text-slate-500 hover:bg-slate-50 hover:text-slate-700")">
        <i class="bi bi-shield-lock text-sm"></i> Autenticacion de dos factores
    </a>
    <a asp-page="./PersonalData"
       class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium transition
              @(ManageNavPages.PersonalDataNavClass(ViewContext) == "active" ? "bg-primary-50 text-primary-600" : "text-slate-500 hover:bg-slate-50 hover:text-slate-700")">
        <i class="bi bi-database text-sm"></i> Datos personales
    </a>
</nav>
