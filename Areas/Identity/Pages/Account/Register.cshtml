@page
@model RegisterModel
@{
    ViewData["Title"] = "Registrarse";
}

<div class="min-h-[70vh] flex items-center justify-center fade-in">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <div class="px-8 pt-8 pb-6 text-center">
                <div class="w-14 h-14 rounded-2xl bg-primary-100 flex items-center justify-center mx-auto mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="text-primary-500" viewBox="0 0 16 16">
                        <path d="M13 1a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h10zM3 0a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V3a3 3 0 0 0-3-3H3z"/>
                        <path d="M5.5 8a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm-2.5 4v.5a.5.5 0 0 0 .5.5h6a.5.5 0 0 0 .5-.5V12a2.5 2.5 0 0 0-5 0H3z"/>
                    </svg>
                </div>
                <h2 class="text-xl font-bold text-slate-800 mb-1">Crear Cuenta</h2>
                <p class="text-sm text-slate-400">Registrate para acceder a TechRent</p>
            </div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="px-8 pb-8">
                <div asp-validation-summary="ModelOnly" class="bg-rose-50 border border-rose-200 text-rose-600 text-sm rounded-xl px-4 py-3 mb-4" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="Input.Email" class="block text-sm font-medium text-slate-600 mb-1.5">Correo electronico</label>
                    <input asp-for="Input.Email" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" autocomplete="username" aria-required="true" placeholder="tu@email.com" />
                    <span asp-validation-for="Input.Email" class="text-rose-500 text-xs mt-1 block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.Password" class="block text-sm font-medium text-slate-600 mb-1.5">Contrasena</label>
                    <input asp-for="Input.Password" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" autocomplete="new-password" aria-required="true" placeholder="********" />
                    <span asp-validation-for="Input.Password" class="text-rose-500 text-xs mt-1 block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-slate-600 mb-1.5">Confirmar Contrasena</label>
                    <input asp-for="Input.ConfirmPassword" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition" autocomplete="new-password" aria-required="true" placeholder="********" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-rose-500 text-xs mt-1 block"></span>
                </div>

                <div class="mb-6">
                    <label asp-for="Input.SelectedRole" class="block text-sm font-medium text-slate-600 mb-1.5">Rol</label>
                    <select asp-for="Input.SelectedRole" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-slate-700 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition bg-white" asp-items="Model.RolesList">
                        <option value="">-- Selecciona un rol --</option>
                    </select>
                    <span asp-validation-for="Input.SelectedRole" class="text-rose-500 text-xs mt-1 block"></span>
                    <p class="text-xs text-slate-400 mt-1">Elige el rol que se te asignara en el sistema.</p>
                </div>

                <button id="registerSubmit" type="submit"
                        class="w-full py-2.5 rounded-xl bg-primary-500 text-white text-sm font-semibold hover:bg-primary-600 transition shadow-sm">
                    Registrarse
                </button>
            </form>

            @if (Model.ExternalLogins?.Count > 0)
            {
                <div class="px-8 pb-2">
                    <div class="relative mb-4">
                        <div class="absolute inset-0 flex items-center">
                            <div class="w-full border-t border-slate-100"></div>
                        </div>
                        <div class="relative flex justify-center">
                            <span class="bg-white px-3 text-xs text-slate-400">O registrate con</span>
                        </div>
                    </div>

                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="mb-6">
                        <input type="hidden" name="provider" value="Google" />
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            if (provider.Name == "Google")
                            {
                                <button type="submit"
                                        class="w-full flex items-center justify-center gap-2.5 px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:border-slate-300 transition">
                                    <svg width="18" height="18" viewBox="0 0 48 48" fill="none">
                                        <path fill="#4285F4" d="M47.532 24.552c0-1.632-.142-3.2-.422-4.704H24.48v8.91h12.964c-.56 2.992-2.25 5.536-4.8 7.242v6.024h7.764c4.542-4.184 7.168-10.336 7.168-17.472z"/>
                                        <path fill="#34A853" d="M24.48 48c6.48 0 11.908-2.144 15.876-5.784l-7.764-6.024c-2.144 1.424-4.88 2.264-8.112 2.264-6.24 0-11.536-4.208-13.424-9.872H3.102v6.216C7.078 42.656 15.222 48 24.48 48z"/>
                                        <path fill="#FBBC05" d="M11.056 28.584c-.48-1.424-.752-2.944-.752-4.584s.272-3.16.752-4.584v-6.216H3.102C1.104 17.064 0 20.392 0 24s1.104 6.936 3.102 9.936l7.954-5.352z"/>
                                        <path fill="#EA4335" d="M24.48 9.544c3.52 0 6.68 1.216 9.168 3.584l6.864-6.864C36.364 2.12 30.948 0 24.48 0 15.222 0 7.078 5.344 3.102 14.064l7.954 5.352c1.888-5.664 7.184-9.872 13.424-9.872z"/>
                                    </svg>
                                    Google
                                </button>
                            }
                        }
                    </form>
                </div>
            }

            <div class="px-8 pb-6 text-center">
                <p class="text-sm text-slate-400">
                    Ya tienes una cuenta?
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="font-semibold text-primary-500 hover:text-primary-600 transition">Inicia sesion</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
