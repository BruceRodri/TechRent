@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Verificacion de dos factores";
}

<div class="min-h-[70vh] flex items-center justify-center fade-in">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
            <div class="px-8 pt-8 pb-6 text-center">
                <div class="w-16 h-16 rounded-2xl bg-emerald-100 flex items-center justify-center mx-auto mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="text-emerald-500">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                </div>
                <h2 class="text-xl font-bold text-slate-800 mb-1">Verificacion en dos pasos</h2>
                <p class="text-sm text-slate-400">Ingresa el codigo de 6 digitos de tu aplicacion de autenticacion</p>
            </div>

            <form id="two-factor-form" method="post" class="px-8 pb-8">
                <div asp-validation-summary="ModelOnly" class="bg-rose-50 border border-rose-200 text-rose-600 text-sm rounded-xl px-4 py-3 mb-4" role="alert"></div>

                <input type="hidden" asp-for="RememberMe" />

                <div class="mb-5">
                    <label asp-for="Input.AuthenticatorCode" class="block text-sm font-medium text-slate-600 mb-2 text-center">Codigo de verificacion</label>
                    <input asp-for="Input.AuthenticatorCode"
                           class="w-full px-4 py-4 rounded-xl border-2 border-slate-200 text-slate-800 text-center text-2xl tracking-[0.4em] font-mono font-semibold placeholder-slate-300 focus:outline-none focus:border-primary-400 focus:ring-4 focus:ring-primary-100 transition"
                           autocomplete="off"
                           placeholder="_ _ _ _ _ _"
                           maxlength="7"
                           required />
                    <span asp-validation-for="Input.AuthenticatorCode" class="text-rose-500 text-xs mt-1.5 block text-center"></span>
                </div>

                <button type="submit"
                        class="w-full py-3 rounded-xl bg-primary-500 text-white text-sm font-semibold hover:bg-primary-600 transition shadow-sm flex items-center justify-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Verificar e ingresar
                </button>

                <p class="text-xs text-slate-400 text-center mt-4">
                    Abre tu aplicacion de autenticacion (Google Authenticator, Authy, etc.) y copia el codigo de 6 digitos.
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var input = document.getElementById('Input_AuthenticatorCode');
            if (input) {
                input.focus();
                input.addEventListener('input', function () {
                    this.value = this.value.replace(/[^0-9]/g, '');
                    if (this.value.length > 6) this.value = this.value.substring(0, 6);
                });
            }
        });
    </script>
}
